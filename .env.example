# Web3Forms (sondage)
PUBLIC_WEB3FORMS_KEY=

# Google Search Console HTML tag verification (content value only)
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Apps Script web app URL for careers form → Sheets
# Prefer the /macros/s/.../exec URL (not /a/macros/docnote.ch/...)
# Deploy must be: Execute as Me, Who has access = Anyone
PUBLIC_GOOGLE_SHEETS_CAREERS_URL=https://script.google.com/macros/s/AKfycbxeict3gLPepxmJHo1-v5Upqb4G9krK6NcUQ-Ir2PYYHsOlw46CGQxaOaQ4g_wHTvOw/exec

# DocNote backend. Defaults to production when unset; point it at the local
# Firebase emulator to try the purchase-order page against a local backend:
# PUBLIC_API_URL=http://127.0.0.1:9000/docnote-staging/europe-west6/api
PUBLIC_API_URL=
