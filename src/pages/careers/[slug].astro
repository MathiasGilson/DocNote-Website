---
import CareerJobPage from '../../components/pages/CareerJobPage.astro';
import { defaultLocale } from '../../utils/i18n';
import { CAREER_JOB_SLUGS } from '../../utils/careers';

export function getStaticPaths() {
  return CAREER_JOB_SLUGS.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
---

<CareerJobPage locale={defaultLocale} slug={slug as string} />
