---
import Layout from '../../layouts/Layout.astro';
import Main from '../../components/Main.astro';
import { nonDefaultLocales, type Locale } from '../../utils/i18n';
import { getPageMeta } from '../../utils/seo';

export function getStaticPaths() {
  return nonDefaultLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const meta = getPageMeta('home', locale);
---

<Layout title={meta.title} description={meta.description}>
  <Main locale={locale} variant="locale" />
</Layout>
