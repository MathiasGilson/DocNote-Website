---
import GtcPage from '../../components/pages/GtcPage.astro';
import { nonDefaultLocales, type Locale } from '../../utils/i18n';

export function getStaticPaths() {
  return nonDefaultLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
---

<GtcPage locale={locale} />
