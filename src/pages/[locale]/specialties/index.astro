---
import SpecialtiesHubPage from '../../../components/pages/SpecialtiesHubPage.astro';
import { nonDefaultLocales, isValidLocale, type Locale } from '../../../utils/i18n';

export function getStaticPaths() {
  return nonDefaultLocales.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params;
if (!isValidLocale(locale)) {
  return Astro.redirect('/');
}
---

<SpecialtiesHubPage locale={locale as Locale} />
