---
import SpecialtyFamilyPage from '../../../components/pages/SpecialtyFamilyPage.astro';
import { nonDefaultLocales, isValidLocale, type Locale } from '../../../utils/i18n';
import { specialtyFamilySlugs, isSpecialtyFamilySlug } from '../../../content/specialty-families';

export function getStaticPaths() {
  return nonDefaultLocales.flatMap((locale) =>
    specialtyFamilySlugs.map((family) => ({
      params: { locale, family },
    }))
  );
}

const { locale, family } = Astro.params;
if (!isValidLocale(locale) || !family || !isSpecialtyFamilySlug(family)) {
  return Astro.redirect('/');
}
---

<SpecialtyFamilyPage locale={locale as Locale} family={family} />
