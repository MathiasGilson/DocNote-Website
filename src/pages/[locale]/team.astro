---
import TeamPage from '../../components/pages/TeamPage.astro';
import { nonDefaultLocales, type Locale } from '../../utils/i18n';

export function getStaticPaths() {
  return nonDefaultLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
---

<TeamPage locale={locale} />
