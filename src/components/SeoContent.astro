---
// Visually-hidden semantic content for SEO, AEO, GEO and LLMO.
// Rendered to the DOM (so crawlers and LLMs can read it) but invisible to
// sighted users. Uses .sr-only --- Google explicitly accepts visually-hidden
// content as long as it is real, accessible, and not keyword spam.
//
// We render TWO variants --- one for Switzerland (CH: Swiss hosting, FADP/nLPD,
// Swiss DRG, Art. 321 CP) and one for France/Rest of World (ROW: France HDS
// hosting, GDPR, PMSI, Art. 226-13). The ROW variant is shown by default;
// a small client script swaps to the CH variant if the visitor is detected
// as Swiss (timezone first, IP fallback). Both versions exist in the DOM,
// but the inactive one carries `hidden` so search engines see the active set.

interface Props {
  locale: string;
}

const { locale } = Astro.props;

type Variant = {
  h2: string;
  paragraphs: string[];
};

type SeoBlock = { ch: Variant; row: Variant };

const modules = import.meta.glob('../content/inline/seo-content/*.json', { eager: true }) as Record<
  string,
  { default: SeoBlock }
>;

const byLocale: Record<string, SeoBlock> = {};
for (const [path, mod] of Object.entries(modules)) {
  const code = path.split('/').pop()?.replace(/\.json$/, '') || '';
  byLocale[code] = (mod as any).default ?? (mod as any);
}

const c: SeoBlock = byLocale[locale] ?? byLocale.en;
---

<section class="sr-only" aria-hidden="false" data-seo-content-row>
  <h2>{c.row.h2}</h2>
  {c.row.paragraphs.map((p) => <p>{p}</p>)}
</section>
<section class="sr-only" aria-hidden="false" data-seo-content-ch hidden>
  <h2>{c.ch.h2}</h2>
  {c.ch.paragraphs.map((p) => <p>{p}</p>)}
</section>

<script>
  import { detectUserCurrency } from '../utils/currency';

  (async () => {
    const currency = await detectUserCurrency();
    if (currency !== 'CHF') return;
    const row = document.querySelector<HTMLElement>('[data-seo-content-row]');
    const ch = document.querySelector<HTMLElement>('[data-seo-content-ch]');
    if (!row || !ch) return;
    row.hidden = true;
    ch.hidden = false;
  })();
</script>
