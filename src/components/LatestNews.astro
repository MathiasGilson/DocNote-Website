---
import { getCollection, getEntry } from 'astro:content';
import BlogCard from './ui/BlogCard.astro';
import { getLocalizedPath, type Locale } from '../utils/i18n';
import { CATEGORY_META, type BlogCategory } from '../utils/blogCategories';
import { isCanonicalBlogPostId } from '../utils/blog-translations';

interface Props {
  locale?: string;
  translations: any;
}

const { locale = 'en', translations: t } = Astro.props;
const loc = locale as Locale;

const loadNews = async (lang: string) => {
  const posts = await getCollection('blog', ({ id, data }) => {
    return id.startsWith(`${lang}/`) && isCanonicalBlogPostId(id) && data.category === 'news';
  });
  return posts.sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  );
};

let newsPosts = await loadNews(loc);
if (newsPosts.length < 3 && loc !== 'en') {
  const enNews = await loadNews('en');
  const have = new Set(
    newsPosts.map((p) => p.id.replace(`${loc}/`, '').replace(/\.mdx?$/, ''))
  );
  for (const post of enNews) {
    if (newsPosts.length >= 3) break;
    const slug = post.id.replace('en/', '').replace(/\.mdx?$/, '');
    if (!have.has(slug)) newsPosts.push(post);
  }
}

const latest = newsPosts.slice(0, 3);
const enPages = loc === 'en' ? null : await getEntry('pages', 'en');
const blog = {
  badge: t.blog?.categories?.news || enPages?.data.blog.categories.news || 'News',
  title: t.blog?.recentPosts || enPages?.data.blog.recentPosts || 'Recent Posts',
  subtitle:
    t.blog?.subtitle ||
    enPages?.data.blog.subtitle ||
    'Company updates, events, and announcements from DocNote.',
  readMore: t.blog?.readMore || enPages?.data.blog.readMore || 'Read More',
  viewAll: t.nav?.blog || enPages?.data.nav.blog || 'News',
};

const cards = latest.map((post) => {
  const lang = post.id.split('/')[0];
  const slug = post.id.replace(`${lang}/`, '').replace(/\.mdx?$/, '');
  const cat = post.data.category as BlogCategory;
  return {
    href: getLocalizedPath(`/blog/${slug}`, loc),
    title: post.data.title,
    excerpt: post.data.excerpt,
    image: post.data.image,
    imagePosition: post.data.imagePosition,
    date: post.data.date,
    categoryLabel: blog.badge,
    categoryClass: CATEGORY_META[cat]?.badge || CATEGORY_META.news.badge,
  };
});

const blogHref = getLocalizedPath('/blog', loc);
---

{
  cards.length > 0 && (
    <section class="latest-news py-20 lg:py-24 bg-white" data-latest-news>
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-10 lg:mb-12 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 reveal">
          <div class="max-w-2xl">
            <span class="inline-flex items-center gap-2 text-xs font-semibold text-primary-600 uppercase tracking-widest">
              <span class="latest-news-dot" aria-hidden="true"></span>
              {blog.badge}
            </span>
            <h2 class="mt-3 text-2xl sm:text-3xl lg:text-4xl font-semibold text-gray-900 leading-snug tracking-tight">
              {blog.title}
            </h2>
            <p class="mt-3 text-base text-gray-500 leading-relaxed">{blog.subtitle}</p>
          </div>
          <a
            href={blogHref}
            class="inline-flex items-center gap-1.5 text-sm font-semibold text-[var(--dn-primary-ink)] hover:text-[var(--dn-primary-end)] transition-colors shrink-0"
          >
            {blog.viewAll}
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path
                d="M2.625 7H11.375M11.375 7L7.875 3.5M11.375 7L7.875 10.5"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {cards.map((post) => (
            <BlogCard
              href={post.href}
              title={post.title}
              excerpt={post.excerpt}
              image={post.image}
              imagePosition={post.imagePosition}
              date={post.date}
              locale={loc}
              categoryLabel={post.categoryLabel}
              categoryClass={post.categoryClass}
              readMore={blog.readMore}
            />
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .latest-news-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--dn-primary);
    box-shadow: 0 0 0 3px rgba(var(--dn-primary-rgb), 0.18);
  }
</style>
