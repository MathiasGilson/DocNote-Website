---
import { getLocalizedPath, getCareersPath, type Locale } from "../utils/i18n"
import { footerLandingSlugs, getLandingNavLabel } from "../content/landings"

interface Props {
    locale: Locale
    translations: any
}

const { locale, translations: t } = Astro.props
const currentYear = new Date().getFullYear()
const careersHref = getCareersPath(locale)

const productsLabel =
    locale === "fr"
        ? "Produits"
        : locale === "de"
          ? "Produkte"
          : locale === "ru"
            ? "Продукты"
            : locale === "es"
              ? "Productos"
              : "Products"

const resourcesLabel =
    locale === "fr"
        ? "Ressources"
        : locale === "de"
          ? "Ressourcen"
          : locale === "ru"
            ? "Ресурсы"
            : locale === "es"
              ? "Recursos"
              : "Resources"

const hostedLabel =
    locale === "fr"
        ? "Hébergé en Suisse"
        : locale === "de"
          ? "Gehostet in der Schweiz"
          : locale === "ru"
            ? "Хостинг в Швейцарии"
            : locale === "es"
              ? "Alojado en Suiza"
              : "Hosted in Switzerland"

const APP_IOS = "https://apps.apple.com/ch/app/docnote-for-doctors/id6741168204"
const APP_ANDROID = "https://play.google.com/store/apps/details?id=app.docnote&pli=1"
const APP_WEB = "https://docnote.care/app/"
---

<footer id="site-footer" class="site-footer">
    <div class="site-footer__glow" aria-hidden="true"></div>
    <div class="site-footer__inner">
        <div class="site-footer__grid">
            <div class="site-footer__brand">
                <a href={getLocalizedPath("/", locale)} class="site-footer__logo">
                    <img src="/images/logo.png" alt="DocNote" width="32" height="32" class="site-footer__logo-img" />
                    <span>DocNote</span>
                </a>
                <p class="site-footer__desc">{t.footer.description}</p>
                <p class="site-footer__trust">
                    <span class="site-footer__trust-item">
                        <span class="site-footer__trust-icon" aria-hidden="true">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                                <path d="M12 3l7 3v5.5c0 4.4-2.9 8.4-7 9.5-4.1-1.1-7-5.1-7-9.5V6l7-3z" fill="currentColor" opacity="0.18"/>
                                <path d="M12 3l7 3v5.5c0 4.4-2.9 8.4-7 9.5-4.1-1.1-7-5.1-7-9.5V6l7-3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                                <path d="M12 8.2v7.2M9.4 11.2h5.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                            </svg>
                        </span>
                        <span>HIPAA</span>
                    </span>
                    <span aria-hidden="true">·</span>
                    <span class="site-footer__trust-item">
                        <span class="site-footer__trust-icon" aria-hidden="true">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                                <circle cx="12" cy="12" r="8.25" stroke="currentColor" stroke-width="1.5"/>
                                <circle cx="12" cy="12" r="5.5" stroke="currentColor" stroke-width="1.2" opacity="0.55"/>
                                <path d="M12 7.6v4.2l2.4 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </span>
                        <span>ISO 27001</span>
                    </span>
                    <span aria-hidden="true">·</span>
                    <span class="site-footer__trust-item">
                        <span class="site-footer__trust-icon site-footer__trust-icon--flag" aria-hidden="true">
                            <img src="/images/flags/ch.svg" alt="Switzerland" width="14" height="14" loading="lazy" decoding="async" />
                        </span>
                        <span>{hostedLabel}</span>
                    </span>
                </p>
                <a
                    href="https://linkedin.com/company/docnote-for-doctors"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="site-footer__social"
                    aria-label="LinkedIn"
                >
                    <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                    </svg>
                </a>
            </div>

            <div class="site-footer__col">
                <h4 class="site-footer__heading">{productsLabel}</h4>
                <ul class="site-footer__list">
                    <li>
                        <a href={APP_IOS} target="_blank" rel="noopener noreferrer">iOS App</a>
                    </li>
                    <li>
                        <a href={APP_ANDROID} target="_blank" rel="noopener noreferrer">Android App</a>
                    </li>
                    <li>
                        <a href={APP_WEB} target="_blank" rel="noopener noreferrer">Web App</a>
                    </li>
                </ul>
            </div>

            <div class="site-footer__col">
                <h4 class="site-footer__heading">{t.footer.company}</h4>
                <ul class="site-footer__list">
                    <li>
                        <a href={getLocalizedPath("/team", locale)}>{t.footer.about}</a>
                    </li>
                    <li>
                        <a href={getLocalizedPath("/contact", locale)}>{t.footer.contact}</a>
                    </li>
                    <li>
                        <a href={careersHref}>{t.footer.careers}</a>
                    </li>
                    <li>
                        <a href="https://www.linkedin.com/company/107244351" target="_blank" rel="noopener noreferrer">LinkedIn</a>
                    </li>
                </ul>
            </div>

            <div class="site-footer__col">
                <h4 class="site-footer__heading">{resourcesLabel}</h4>
                <ul class="site-footer__list">
                    {
                        footerLandingSlugs.map((slug) => (
                            <li>
                                <a href={getLocalizedPath(`/${slug}`, locale)}>
                                    {getLandingNavLabel(slug, locale)}
                                </a>
                            </li>
                        ))
                    }
                    <li>
                        <a href={getLocalizedPath("/blog", locale)}>{t.nav.blog}</a>
                    </li>
                </ul>
            </div>

            <div class="site-footer__col">
                <h4 class="site-footer__heading">{t.footer.legal}</h4>
                <ul class="site-footer__list">
                    <li>
                        <a href={getLocalizedPath("/privacy", locale)}>{t.footer.privacy}</a>
                    </li>
                    <li>
                        <a href={getLocalizedPath("/gtc", locale)}>{t.footer.gtc}</a>
                    </li>
                </ul>
            </div>
        </div>

        <div class="site-footer__bottom">
            <p class="site-footer__copy">&copy; {currentYear} DocNote. {t.footer.rights}</p>
            <nav class="site-footer__legal" aria-label={t.footer.legal}>
                <a href={getLocalizedPath("/privacy", locale)}>{t.footer.privacy}</a>
                <a href={getLocalizedPath("/gtc", locale)}>{t.footer.gtc}</a>
            </nav>
        </div>
    </div>
</footer>

<style>
  .site-footer {
    --footer-ink: #f1f5f9;
    --footer-muted: #94a3b8;
    --footer-dim: #64748b;
    --footer-line: rgba(148, 163, 184, 0.14);
    --footer-accent: rgba(var(--dn-primary-rgb), 0.55);

    position: relative;
    z-index: 1;
    overflow: hidden;
    color: var(--footer-muted);
    background:
      linear-gradient(180deg, #121a2b 0%, #0c1320 48%, #0a101c 100%);
  }

  .site-footer::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(var(--dn-primary-rgb), 0.35) 35%,
      rgba(241, 245, 249, 0.18) 50%,
      rgba(var(--dn-primary-rgb), 0.28) 65%,
      transparent 100%
    );
    pointer-events: none;
  }

  .site-footer__glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(70% 55% at 12% 0%, rgba(var(--dn-primary-rgb), 0.1) 0%, transparent 55%),
      radial-gradient(50% 40% at 88% 18%, rgba(148, 163, 184, 0.06) 0%, transparent 50%);
  }

  @media (min-width: 1024px) {
    .site-footer {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
    }
  }

  .site-footer__inner {
    position: relative;
    max-width: 72rem;
    margin: 0 auto;
    padding: 2.75rem 1.25rem 1.75rem;
  }

  @media (min-width: 640px) {
    .site-footer__inner {
      padding: 3.25rem 1.5rem 2rem;
    }
  }

  @media (min-width: 1024px) {
    .site-footer__inner {
      padding: 3.75rem 2rem 7.5rem;
    }
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.25rem 1.75rem;
    align-items: start;
  }

  @media (min-width: 768px) {
    .site-footer__grid {
      grid-template-columns: minmax(12rem, 1.55fr) repeat(4, minmax(0, 1fr));
      gap: 2.5rem 2rem;
    }
  }

  .site-footer__brand {
    grid-column: 1 / -1;
    max-width: 20rem;
  }

  @media (min-width: 768px) {
    .site-footer__brand {
      grid-column: auto;
      max-width: none;
      padding-right: 0.5rem;
    }
  }

  .site-footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.95rem;
    text-decoration: none;
    color: var(--footer-ink);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    transition: opacity 0.15s ease;
  }

  .site-footer__logo:hover {
    opacity: 0.88;
  }

  .site-footer__logo:focus-visible {
    outline: 2px solid rgba(var(--dn-primary-rgb), 0.7);
    outline-offset: 4px;
    border-radius: 0.25rem;
  }

  .site-footer__logo-img {
    width: 1.75rem;
    height: 1.75rem;
    object-fit: contain;
  }

  .site-footer__desc {
    margin: 0 0 1.1rem;
    max-width: 17.5rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--footer-muted);
  }

  .site-footer__trust {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.55rem;
    margin: 0 0 1.15rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #cbd5e1;
  }

  .site-footer__trust > span[aria-hidden="true"] {
    color: rgba(148, 163, 184, 0.45);
    font-weight: 400;
  }

  .site-footer__trust-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .site-footer__trust-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 1.1rem;
    height: 1.1rem;
    color: rgba(var(--dn-primary-rgb), 0.95);
  }

  .site-footer__trust-icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .site-footer__trust-icon--flag {
    border-radius: 0.2rem;
    overflow: hidden;
    box-shadow: 0 0 0 1px rgba(148, 163, 184, 0.25);
  }

  .site-footer__trust-icon--flag img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .site-footer__social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.625rem;
    border: 1px solid rgba(148, 163, 184, 0.2);
    color: #cbd5e1;
    background: rgba(255, 255, 255, 0.02);
    transition:
      color 0.18s ease,
      border-color 0.18s ease,
      background 0.18s ease;
  }

  .site-footer__social:hover {
    color: #fff;
    border-color: rgba(var(--dn-primary-rgb), 0.45);
    background: rgba(var(--dn-primary-rgb), 0.12);
  }

  .site-footer__social:focus-visible {
    outline: 2px solid rgba(var(--dn-primary-rgb), 0.7);
    outline-offset: 3px;
  }

  .site-footer__heading {
    margin: 0 0 1rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #a8b4c4;
  }

  .site-footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .site-footer__list a {
    display: inline-block;
    font-size: 0.875rem;
    line-height: 1.35;
    color: #d7dee8;
    text-decoration: none;
    text-underline-offset: 0.22em;
    transition: color 0.15s ease;
  }

  .site-footer__list a:hover {
    color: #fff;
    text-decoration: underline;
    text-decoration-color: rgba(var(--dn-primary-rgb), 0.55);
  }

  .site-footer__list a:focus-visible {
    outline: 2px solid rgba(var(--dn-primary-rgb), 0.7);
    outline-offset: 3px;
    border-radius: 0.15rem;
  }

  .site-footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-top: 2.5rem;
    padding-top: 1.35rem;
    border-top: 1px solid var(--footer-line);
  }

  @media (min-width: 640px) {
    .site-footer__bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 1.25rem;
    }
  }

  .site-footer__copy {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.4;
    color: var(--footer-dim);
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
  }

  .site-footer__legal a {
    font-size: 0.78rem;
    color: var(--footer-dim);
    text-decoration: none;
    text-underline-offset: 0.2em;
    transition: color 0.15s ease;
  }

  .site-footer__legal a:hover {
    color: #e2e8f0;
    text-decoration: underline;
    text-decoration-color: rgba(var(--dn-primary-rgb), 0.45);
  }

  .site-footer__legal a:focus-visible {
    outline: 2px solid rgba(var(--dn-primary-rgb), 0.7);
    outline-offset: 3px;
    border-radius: 0.15rem;
  }
</style>
