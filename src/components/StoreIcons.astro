---
// Apple mark: official logo fetched from logo.dev (img.logo.dev/apple.com, greyscale) and
// stored locally so the site does not depend on the API at runtime. It is applied as a CSS
// mask so it takes the button text color. Google Play has no company domain on logo.dev
// (every candidate resolves to the Google "G"), so its glyph is an inline monochrome SVG.
interface Props {
  store: 'apple' | 'google';
  class?: string;
}
const { store, class: className = 'w-4 h-4' } = Astro.props;
---
{store === 'apple' ? (
  <span
    class:list={['inline-block bg-current', className]}
    style="mask: url('/images/logo_apple.png') center / contain no-repeat; -webkit-mask: url('/images/logo_apple.png') center / contain no-repeat;"
    aria-hidden="true"
  ></span>
) : (
  <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M3.6 1.8c-.3.3-.5.8-.5 1.4v17.6c0 .6.2 1.1.5 1.4l9.9-10.2L3.6 1.8zm1.8.1L13.5 12l3.3-3.4L5.4 1.9c-.7-.4-1.4-.4-1.8-.1zM3.6 22.2l9.9-10.2 3.3 3.4L5.4 22.1c-.7.4-1.4.4-1.8.1zm13.2-13.6-3.3 3.4 3.3 3.4 3.8-2.1c1.1-.6 1.1-1.9 0-2.5l-3.8-2.2z"/>
  </svg>
)}
