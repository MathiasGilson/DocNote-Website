  .encrypt-demo.is-ready .encrypt-row.r-1 { transition-delay: 0.02s; }
  .encrypt-demo.is-ready .encrypt-row.r-2 { transition-delay: 0.08s; }
  .encrypt-demo.is-ready .encrypt-row.r-3 { transition-delay: 0.14s; }
  .encrypt-demo.is-ready .encrypt-row.r-4 { transition-delay: 0.2s; }

  .encrypt-label {
    font-size: 9px;
    font-weight: 700;
    color: #9ca3af;
    text-transform: uppercase;
    letter-spacing: 0.04em;
