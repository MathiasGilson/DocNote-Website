  }

  .group:hover .summary-section.s-2 .summary-bar-fill {
    width: 100%;
    transition: width 0.45s cubic-bezier(0.22, 1, 0.36, 1) 0.4s;
  }

  .group:hover .summary-section.s-3 .summary-bar-fill {
