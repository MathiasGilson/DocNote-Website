    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--dn-primary-mid);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: scale(0.5);
    transition:
      opacity 0.28s ease,
      transform 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .encrypt-demo.is-locked .encrypt-shield-badge {
    opacity: 1;
    transform: scale(1);
