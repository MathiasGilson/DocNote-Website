  /* ── Card 5: Security (plain → encrypted) ── */
  .encrypt-demo {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 14px 16px;
  }

  .encrypt-cluster {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    max-width: 100%;
  }

  .encrypt-lines {
    display: flex;
    flex-direction: column;
    gap: 4px;
    justify-content: center;
    min-width: 0;
  }

  .encrypt-row {
    display: flex;
    align-items: center;
    gap: 8px;
