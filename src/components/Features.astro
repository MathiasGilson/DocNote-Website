  /* ── Card 6: Multilingual ── */
  .lang-demo {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lang-tabs {
    position: absolute;
    top: 12px;
    right: 12px;
    display: flex;
    gap: 3px;
    z-index: 2;
    padding: 3px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(15, 23, 42, 0.06);
    backdrop-filter: blur(6px);
  }

  .lang-tab {
    font-size: 8px;
    font-weight: 700;
    color: #c4c9d4;
    letter-spacing: 0.03em;
    padding: 3px 5px;
    border-radius: 5px;
    background: transparent;
    transition: color 0.3s ease, background 0.3s ease, transform 0.3s ease;
  }

  .lang-tab.is-active {
    color: var(--dn-primary-ink);
    background: rgba(var(--dn-primary-rgb), 0.12);
    transform: scale(1.05);
  }

  .lang-doc {
    position: absolute;
    inset: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .lang-doc-header {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .lang-doc-icon {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    background: rgba(var(--dn-primary-rgb), 0.1);
    color: var(--dn-primary-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .lang-doc-title {
    position: relative;
    height: 18px;
    display: flex;
    align-items: center;
  }

  .lang-title-text {
    font-size: 13px;
    font-weight: 600;
    color: #374151;
    letter-spacing: 0.01em;
    position: absolute;
    left: 0;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .lang-title-text.is-active {
    opacity: 1;
    transform: translateY(0);
  }

  .lang-lines {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding-right: 44px;
  }

  .lang-bar {
    height: 5px;
    background: #f3f4f6;
    border-radius: 2.5px;
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  .lang-bar::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(var(--dn-primary-rgb), 0.22), rgba(var(--dn-primary-mid-rgb), 0.32));
    width: 0%;
    border-radius: 2.5px;
    transition: width 0.4s ease;
  }

  .lang-badge {
    position: absolute;
    bottom: 12px;
    right: 16px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--dn-gradient);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: scale(0.5);
    box-shadow: var(--dn-glow-sm);
  }

  .group:hover .lang-line.l-1 .lang-bar::after { width: 100%; transition: width 0.32s ease 0.05s; }
  .group:hover .lang-line.l-2 .lang-bar::after { width: 100%; transition: width 0.32s ease 0.14s; }
  .group:hover .lang-line.l-3 .lang-bar::after { width: 100%; transition: width 0.32s ease 0.23s; }
  .group:hover .lang-line.l-4 .lang-bar::after { width: 100%; transition: width 0.32s ease 0.32s; }
  .group:hover .lang-line.l-5 .lang-bar::after { width: 100%; transition: width 0.32s ease 0.41s; }
  .group:hover .lang-line.l-6 .lang-bar::after { width: 100%; transition: width 0.32s ease 0.5s; }
  .group:hover .lang-line.l-7 .lang-bar::after { width: 100%; transition: width 0.32s ease 0.59s; }

  .group:hover .lang-badge {
    opacity: 1;
    transform: scale(1);
    transition: opacity 0.2s ease 0.85s, transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) 0.85s;
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .record-ring,
    .record-btn-dot,
    .record-wave span,
    .transcript-dot.recording,
    .transcript-caret {
      animation: none !important;
    }

    .record-ring {
      opacity: 0.25;
      transform: translate(-50%, -50%) scale(1);
    }

    .record-ring.r2,
    .record-ring.r3 {
      display: none;
    }

    .record-wave span {
      transform: none;
      opacity: 0.5;
    }

    .feature-card:hover {
      transform: none;
    }

    .group:hover .transcript-scrub::after,
    .is-recording-live .transcript-scrub::after {
      animation: none;
      width: 72%;
    }

    .is-recording-live .transcript-caret {
      animation: none !important;
      opacity: 0.35;
    }

    .animate-correct .transcribe-line,
    .animate-correct .tw-wrong,
    .animate-correct .tw-right {
      animation: none !important;
    }

    .animate-correct .transcribe-line {
      opacity: 1;
      transform: none;
      color: #6b7280;
    }

    .animate-correct .tw-wrong { opacity: 0; }
    .animate-correct .tw-right { opacity: 1; }

    .group:hover .summary-section,
    .group:hover .summary-bar-fill,
    .group:hover .summary-badge,
    .group:hover .ehr-bar::after,
    .group:hover .ehr-report-card,
    .group:hover .ehr-success-badge,
    .group:hover .ehr-note-line,
    .group:hover .lang-bar::after,
    .group:hover .lang-badge,
    .group:hover .encrypt-row,
    .group:hover .encrypt-lock,
    .group:hover .encrypt-shield-badge {
      transition-delay: 0s !important;
      transition-duration: 0.01ms !important;
    }

    .group:hover .summary-section { opacity: 1; transform: none; }
    .group:hover .summary-bar-fill { width: 100%; }
    .group:hover .summary-badge,
    .group:hover .ehr-success-badge,
    .group:hover .lang-badge {
      opacity: 1;
      transform: none;
    }

    .group:hover .ehr-bar::after { width: 100%; }
    .group:hover .ehr-report-card {
      opacity: 1;
      transform: translate(52px, -8px) scale(1);
    }
    .group:hover .ehr-note-line { transform: scaleX(1); }
    .group:hover .lang-bar::after { width: 100%; }

    .group:hover .encrypt-row {
      opacity: 1;
      transform: none;
    }
    .group:hover .encrypt-lock {
      opacity: 1;
      transform: scale(1);
    }
    .group:hover .encrypt-shield-badge {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>

<script>
  const prefersReduced = () =>
    window.matchMedia('(prefers-reduced-motion: reduce)').matches

  const transcribeCard = document.getElementById('transcribe-card')
  if (transcribeCard) {
    let restarting = false
    const restartTranscribe = () => {
      if (prefersReduced() || restarting) return
      const ui = transcribeCard.querySelector('.transcribe-ui')
      if (!ui) return
      restarting = true
      ui.classList.remove('animate-correct')
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          ui.classList.add('animate-correct')
          restarting = false
        })
      })
    }
    transcribeCard.addEventListener('mouseenter', restartTranscribe)
  }

  const recordCardEl = document.querySelector<HTMLElement>('[data-record-card]')
  if (recordCardEl) {
    const featureCard = recordCardEl.closest<HTMLElement>('.feature-card')
    const typedEl = recordCardEl.querySelector<HTMLElement>('[data-transcript-typed]')
    const caretEl = recordCardEl.querySelector<HTMLElement>('.transcript-caret')
    const timerEl = recordCardEl.querySelector<HTMLElement>('[data-transcript-timer]')
    const fullText = typedEl?.dataset.fullText ?? ''
    const CHAR_MS = 28
    const LOOP_PAUSE_MS = 1600
    let charTimer = 0
    let loopTimer = 0
    let tickTimer = 0
    let idx = 0
    let seconds = 0

    const formatTimer = (s: number) => {
      const m = Math.floor(s / 60)
      const r = s % 60
      return `${m}:${r.toString().padStart(2, '0')}`
    }

    const stopTimers = () => {
      window.clearInterval(charTimer)
      window.clearTimeout(loopTimer)
      window.clearInterval(tickTimer)
      charTimer = 0
      loopTimer = 0
      tickTimer = 0
    }

    const resetTranscript = () => {
      stopTimers()
      idx = 0
      seconds = 0
      if (typedEl) typedEl.textContent = ''
      if (timerEl) timerEl.textContent = '0:00'
      caretEl?.classList.remove('is-done')
      featureCard?.classList.remove('is-recording-live')
    }

    const showFull = () => {
      if (typedEl) typedEl.textContent = fullText
      caretEl?.classList.add('is-done')
      if (timerEl) timerEl.textContent = '0:12'
    }

    const typeNext = () => {
      if (!typedEl) return
      if (idx >= fullText.length) {
        window.clearInterval(charTimer)
        charTimer = 0
        caretEl?.classList.add('is-done')
        loopTimer = window.setTimeout(() => {
          if (!featureCard?.classList.contains('is-recording-live')) return
          idx = 0
          seconds = 0
          typedEl.textContent = ''
          caretEl?.classList.remove('is-done')
          if (timerEl) timerEl.textContent = '0:00'
          startTyping()
        }, LOOP_PAUSE_MS)
        return
      }
      typedEl.textContent = fullText.slice(0, idx + 1)
      idx += 1
    }

    const startTyping = () => {
      window.clearInterval(charTimer)
      if (prefersReduced()) {
        showFull()
        return
      }
      charTimer = window.setInterval(typeNext, CHAR_MS)
    }

    const startLive = () => {
      if (featureCard?.classList.contains('is-recording-live')) return
      resetTranscript()
      featureCard?.classList.add('is-recording-live')
      if (prefersReduced()) {
        showFull()
        return
      }
      tickTimer = window.setInterval(() => {
        seconds += 1
        if (timerEl) timerEl.textContent = formatTimer(seconds)
      }, 1000)
      startTyping()
    }

    const stopLive = () => {
      resetTranscript()
    }

    const io = new IntersectionObserver(
      (entries) => {
        const entry = entries[0]
        if (!entry) return
        if (entry.isIntersecting && entry.intersectionRatio >= 0.45) {
          startLive()
        } else {
          stopLive()
        }
      },
      { threshold: [0, 0.45, 0.75] }
    )
    io.observe(recordCardEl)

    featureCard?.addEventListener('mouseenter', () => {
      if (!featureCard.classList.contains('is-recording-live')) startLive()
    })
  }

  const langCard = document.getElementById('lang-card')
  if (langCard) {
    const langs = ['fr', 'en', 'it', 'es', 'ar']
    let langIndex = 0
    let langTimer = 0

    const setLang = (code: string) => {
      langCard.querySelectorAll('[data-lang-tab]').forEach((tab) => {
        tab.classList.toggle('is-active', tab.getAttribute('data-lang-tab') === code)
      })
      langCard.querySelectorAll('[data-lang-title]').forEach((title) => {
        title.classList.toggle('is-active', title.getAttribute('data-lang-title') === code)
      })
    }

    langCard.addEventListener('mouseenter', () => {
      langIndex = 0
      setLang(langs[0])
      window.clearInterval(langTimer)
      if (prefersReduced()) return
      langTimer = window.setInterval(() => {
        langIndex = (langIndex + 1) % langs.length
        setLang(langs[langIndex])
      }, 720)
    })

    langCard.addEventListener('mouseleave', () => {
      window.clearInterval(langTimer)
      langIndex = 0
      setLang(langs[0])
    })
  }

  const securityCard = document.querySelector<HTMLElement>('[data-security-card]')
  if (securityCard) {
    const demo = securityCard.querySelector<HTMLElement>('[data-encrypt-demo]')
    const values = Array.from(
      securityCard.querySelectorAll<HTMLElement>('[data-encrypt-value]')
    )
    const ROW_STAGGER_MS = 140
    const CHAR_MS = 22
    const HOLD_MS = 1600
    const RESET_MS = 500
    let timers: number[] = []
    let running = false

    const clearEncryptTimers = () => {
      timers.forEach((id) => {
        window.clearTimeout(id)
        window.clearInterval(id)
      })
      timers = []
    }

    const showPlain = () => {
      demo?.classList.remove('is-locked')
      demo?.classList.add('is-ready')
      values.forEach((el) => {
        el.textContent = el.dataset.plain || ''
        el.classList.remove('is-cipher')
      })
    }

    showPlain()

    const showCipher = () => {
      demo?.classList.add('is-locked')
      values.forEach((el) => {
        el.textContent = el.dataset.cipher || ''
        el.classList.add('is-cipher')
      })
    }

    const scrambleRow = (el: HTMLElement, onDone?: () => void) => {
      const plain = el.dataset.plain || ''
      const cipher = el.dataset.cipher || ''
      const target = cipher || plain.replace(/[^\s.]/g, '•')
      let i = 0
      el.classList.add('is-cipher')
      const id = window.setInterval(() => {
        if (i >= target.length) {
          window.clearInterval(id)
          el.textContent = target
          onDone?.()
          return
        }
        el.textContent = target.slice(0, i + 1) + plain.slice(i + 1)
        i += 1
      }, CHAR_MS)
      timers.push(id)
    }

    const runEncrypt = () => {
      if (!demo || running) return
      running = true
      clearEncryptTimers()
      showPlain()
      demo.classList.add('is-ready')

      if (prefersReduced()) {
        showCipher()
        running = false
        return
      }

      values.forEach((el, idx) => {
        const startId = window.setTimeout(() => {
          scrambleRow(el, () => {
            if (idx === values.length - 1) {
              demo.classList.add('is-locked')
              const holdId = window.setTimeout(() => {
                demo.classList.remove('is-locked')
                const resetId = window.setTimeout(() => {
                  showPlain()
                  running = false
                  const loopId = window.setTimeout(() => {
                    if (securityCard.dataset.encryptLive === '1') runEncrypt()
                  }, 280)
                  timers.push(loopId)
                }, RESET_MS)
                timers.push(resetId)
              }, HOLD_MS)
              timers.push(holdId)
            }
          })
        }, 220 + idx * ROW_STAGGER_MS)
        timers.push(startId)
      })
    }

    const stopEncrypt = () => {
      securityCard.dataset.encryptLive = '0'
      clearEncryptTimers()
      running = false
      showPlain()
      demo?.classList.add('is-ready')
      demo?.classList.remove('is-locked')
    }

    const startEncrypt = () => {
      if (securityCard.dataset.encryptLive === '1') return
      securityCard.dataset.encryptLive = '1'
      runEncrypt()
    }

    const io = new IntersectionObserver(
      (entries) => {
        const entry = entries[0]
        if (!entry) return
        if (entry.isIntersecting && entry.intersectionRatio >= 0.4) {
          startEncrypt()
        } else {
          stopEncrypt()
        }
      },
      { threshold: [0, 0.4, 0.75] }
    )
    io.observe(securityCard)

    securityCard.closest('.feature-card')?.addEventListener('mouseenter', () => {
      stopEncrypt()
      startEncrypt()
    })
  }
</script>
