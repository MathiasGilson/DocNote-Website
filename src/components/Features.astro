---
import type { LandingFeatureKey } from '../content/landings';

interface Props {
  translations: any;
  /** Subset of cards; default = all six (homepage). */
  keys?: LandingFeatureKey[];
  sectionId?: string;
  heading?: { badge?: string; title?: string; subtitle?: string };
  /** Left-aligned header (landings); homepage stays centered. */
  align?: 'center' | 'start';
}

const {
  translations: t,
  keys,
  sectionId = 'features',
  heading,
  align = 'center',
} = Astro.props;

const recordingTranscript = Array.isArray(t.features.recording.animWords)
  ? t.features.recording.animWords.join(' ')
  : String(t.features.recording.animWords || '');

const allFeatures = [
  {
    title: t.features.recording.title,
    description: t.features.recording.description,
    key: 'recording',
  },
  {
    title: t.features.transcription.title,
    description: t.features.transcription.description,
    key: 'transcription',
  },
  {
    title: t.features.summaries.title,
    description: t.features.summaries.description,
    key: 'summaries',
  },
  {
    title: t.features.integration.title,
    description: t.features.integration.description,
    key: 'integration',
  },
  {
    title: t.features.security.title,
    description: t.features.security.description,
    key: 'security',
  },
  {
    title: t.features.languages.title,
    description: t.features.languages.description,
    key: 'languages',
  },
];

const features = keys && keys.length
  ? keys.map((key) => allFeatures.find((f) => f.key === key)).filter(Boolean)
  : allFeatures;

const badge = heading?.badge ?? t.features.badge;
const title = heading?.title ?? t.features.title;
const subtitle = heading?.subtitle ?? t.features.subtitle;
const colsClass =
  features.length <= 2
    ? 'features-grid features-grid--2'
    : features.length === 3
      ? 'features-grid features-grid--3'
      : features.length === 4
        ? 'features-grid features-grid--4'
        : 'features-grid';
---

<section id={sectionId} class="features-section py-20 lg:py-28 scroll-mt-24">
  <div class="features-atmosphere dn-bg-grid" aria-hidden="true"></div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div
      class:list={[
        'mb-10 lg:mb-14 max-w-2xl reveal',
        align === 'center' ? 'mx-auto text-center' : 'text-left',
      ]}
    >
      <span class="inline-flex items-center gap-2 text-xs font-semibold text-primary-600 uppercase tracking-widest">
        <span class="features-badge-dot" aria-hidden="true"></span>
        {badge}
      </span>
      <h2 class="mt-3 text-2xl sm:text-3xl lg:text-4xl font-semibold text-gray-900 leading-snug tracking-tight">
        {title}
      </h2>
      <p class="mt-3 text-base text-gray-500 leading-relaxed">
        {subtitle}
      </p>
    </div>

    <div class={colsClass}>
      {features.map((feature, i) => (
        <div
          class:list={[
            'feature-card-wrap reveal',
            i % 3 === 0 && 'reveal-delay-1',
            i % 3 === 1 && 'reveal-delay-2',
            i % 3 === 2 && 'reveal-delay-3',
          ]}
        >
          <article class="feature-card group" data-feature={feature.key}>
            {feature.key === 'recording' ? (
              <div class="feature-viz" data-record-card>
                <div class="record-demo">
                  <div class="record-idle" aria-hidden="true">
                    <div class="record-rings">
                      <span class="record-ring r1"></span>
                      <span class="record-ring r2"></span>
                      <span class="record-ring r3"></span>
                    </div>
                    <div class="record-btn-dot bg-brand-gradient-br shadow-brand-glow-sm">
                      <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
                      </svg>
                    </div>
                    <div class="record-wave">
                      <span></span><span></span><span></span><span></span><span></span><span></span><span></span>
                    </div>
                  </div>
                  <div class="transcript-ui">
                    <div class="transcript-header">
                      <div class="transcript-dot recording"></div>
                      <span class="transcript-status">{t.features.recording.animStatus}</span>
                      <span class="transcript-timer" data-transcript-timer>0:00</span>
                    </div>
                    <div class="transcript-words">
                      <span class="transcript-typed" data-transcript-typed data-full-text={recordingTranscript}></span><span class="transcript-caret" aria-hidden="true"></span>
                    </div>
                    <div class="transcript-scrub" aria-hidden="true"></div>
                  </div>
                </div>
              </div>
            ) : feature.key === 'transcription' ? (
              <div class="feature-viz" id="transcribe-card" data-transcribe-card>
                <div class="transcribe-demo">
                  <div class="transcribe-ui animate-correct">
                    <div class="transcribe-line l1">
                      <span class="tl-word">{t.features.transcription.animLine1}</span>
                    </div>
                    <div class="transcribe-line l2">
                      {t.features.transcription.animLine2Pre}
                      <span class="tw-correct">
                        <span class="tw-wrong">{t.features.transcription.animWrong1}</span>
                        <span class="tw-right">{t.features.transcription.animRight1}</span>
                      </span>
                      {t.features.transcription.animLine2Post}
                    </div>
                    <div class="transcribe-line l3">
                      {t.features.transcription.animLine3Pre}
                      <span class="tw-correct">
                        <span class="tw-wrong">{t.features.transcription.animWrong2}</span>
                        <span class="tw-right">{t.features.transcription.animRight2}</span>
                      </span>
                      {t.features.transcription.animLine3Post}
                    </div>
                  </div>
                </div>
              </div>
            ) : feature.key === 'summaries' ? (
              <div class="feature-viz" id="summary-card" data-summary-card>
                <div class="summary-demo">
                  <div class="summary-skeleton" aria-hidden="true">
                    <div class="skel-header">
                      <div class="skel-icon"></div>
                      <div class="skel-title-bar"></div>
                    </div>
                    <div class="skel-sections">
                      <div class="skel-block">
                        <div class="skel-label-bar"></div>
                        <div class="skel-line"></div>
                        <div class="skel-line w-3/5"></div>
                      </div>
                      <div class="skel-block">
                        <div class="skel-label-bar w-16"></div>
                        <div class="skel-line"></div>
                      </div>
                      <div class="skel-block">
                        <div class="skel-label-bar w-14"></div>
                        <div class="skel-line w-3/4"></div>
                      </div>
                    </div>
                  </div>
                  <div class="summary-doc">
                    <div class="summary-doc-header">
                      <div class="summary-doc-icon">
                        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                      </div>
                      <span class="summary-doc-title">{t.features.summaries.animTitle}</span>
                    </div>
                    <div class="summary-sections">
                      <div class="summary-section s-1">
                        <div class="summary-section-label">{t.features.summaries.animSection1}</div>
                        <div class="summary-section-bar"><div class="summary-bar-fill"></div></div>
                        <div class="summary-section-bar short"><div class="summary-bar-fill"></div></div>
                      </div>
                      <div class="summary-section s-2">
                        <div class="summary-section-label">{t.features.summaries.animSection2}</div>
                        <div class="summary-section-bar"><div class="summary-bar-fill"></div></div>
                      </div>
                      <div class="summary-section s-3">
                        <div class="summary-section-label">{t.features.summaries.animSection3}</div>
                        <div class="summary-section-bar med"><div class="summary-bar-fill"></div></div>
                      </div>
                    </div>
                  </div>
                  <div class="summary-badge">
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                </div>
              </div>
            ) : feature.key === 'integration' ? (
              <div class="feature-viz" id="ehr-card" data-ehr-card>
                <div class="ehr-demo">
                  <div class="ehr-system">
                    <div class="ehr-header">
                      <div class="ehr-header-dots">
                        <span class="ehr-dot-r"></span><span class="ehr-dot-y"></span><span class="ehr-dot-g"></span>
                      </div>
                      <span class="ehr-header-title">{t.features.integration.animTitle}</span>
                    </div>
                    <div class="ehr-body">
                      <div class="ehr-row">
                        <div class="ehr-label">{t.features.integration.animPatient}</div>
                        <div class="ehr-value"><div class="ehr-bar fill-a"></div></div>
                      </div>
                      <div class="ehr-row">
                        <div class="ehr-label">{t.features.integration.animDob}</div>
                        <div class="ehr-value"><div class="ehr-bar fill-b"></div></div>
                      </div>
                      <div class="ehr-divider"></div>
                      <div class="ehr-row">
                        <div class="ehr-label">{t.features.integration.animNotes}</div>
                        <div class="ehr-value ehr-empty-slot">
                          <span class="ehr-empty-text">{t.features.integration.animNoReport}</span>
                          <div class="ehr-filled-notes" aria-hidden="true">
                            <span class="ehr-note-line"></span>
                            <span class="ehr-note-line short"></span>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="ehr-report-card">
                    <div class="ehr-report-icon">
                      <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                      </svg>
                    </div>
                    <div class="ehr-report-lines">
                      <div class="ehr-report-line"></div>
                      <div class="ehr-report-line short"></div>
                    </div>
                  </div>
                  <div class="ehr-success-badge">
                    <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                </div>
              </div>
            ) : feature.key === 'security' ? (
              <div class="feature-viz feature-viz--flat" id="security-card" data-security-card>
                <div class="encrypt-demo" data-encrypt-demo>
                  <div class="encrypt-cluster">
                    <div class="encrypt-lock" data-encrypt-lock>
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                        <path d="M7 11V7a5 5 0 0110 0v4" />
                      </svg>
                    </div>
                    <div class="encrypt-lines">
                      <div class="encrypt-row r-1">
                        <span class="encrypt-label">{t.features.security.animLabel1}</span>
                        <span
                          class="encrypt-value"
                          data-encrypt-value
                          data-plain={t.features.security.animValue1}
                          data-cipher="••••• •••••••"
                        >{t.features.security.animValue1}</span>
                      </div>
                      <div class="encrypt-row r-2">
                        <span class="encrypt-label">{t.features.security.animLabel2}</span>
                        <span
                          class="encrypt-value"
                          data-encrypt-value
                          data-plain={t.features.security.animValue2}
                          data-cipher="••.••.••••"
                        >{t.features.security.animValue2}</span>
                      </div>
                      <div class="encrypt-row r-3">
                        <span class="encrypt-label">{t.features.security.animLabel3}</span>
                        <span
                          class="encrypt-value"
                          data-encrypt-value
                          data-plain={t.features.security.animValue3}
                          data-cipher="•••• • ••••••••"
                        >{t.features.security.animValue3}</span>
                      </div>
                      <div class="encrypt-row r-4">
                        <span class="encrypt-label">{t.features.security.animLabel4}</span>
                        <span
                          class="encrypt-value"
                          data-encrypt-value
                          data-plain={t.features.security.animValue4}
                          data-cipher="••••• ••••••••"
                        >{t.features.security.animValue4}</span>
                      </div>
                    </div>
                  </div>
                  <div class="encrypt-shield-badge" data-encrypt-badge aria-hidden="true">
                    <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                </div>
              </div>
            ) : (
              <div class="feature-viz" id="lang-card" data-lang-card>
                <div class="lang-demo">
                  <div class="lang-tabs">
                    <span class="lang-tab is-active" data-lang-tab="fr">FR</span>
                    <span class="lang-tab" data-lang-tab="en">EN</span>
                    <span class="lang-tab" data-lang-tab="it">IT</span>
                    <span class="lang-tab" data-lang-tab="es">ES</span>
                    <span class="lang-tab" data-lang-tab="ar">AR</span>
                  </div>
                  <div class="lang-doc">
                    <div class="lang-doc-header">
                      <div class="lang-doc-icon">
                        <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                      </div>
                      <span class="lang-doc-title">
                        <span class="lang-title-text is-active" data-lang-title="fr">Rapport médical</span>
                        <span class="lang-title-text" data-lang-title="en">Medical report</span>
                        <span class="lang-title-text" data-lang-title="it">Referto medico</span>
                        <span class="lang-title-text" data-lang-title="es">Informe médico</span>
                        <span class="lang-title-text" data-lang-title="ar" dir="rtl">تقرير طبي</span>
                      </span>
                    </div>
                    <div class="lang-lines">
                      <div class="lang-line l-1"><div class="lang-bar"></div></div>
                      <div class="lang-line l-2"><div class="lang-bar w-4/5"></div></div>
                      <div class="lang-line l-3"><div class="lang-bar w-3/5"></div></div>
                      <div class="lang-line l-4"><div class="lang-bar w-11/12"></div></div>
                      <div class="lang-line l-5"><div class="lang-bar w-2/3"></div></div>
                      <div class="lang-line l-6"><div class="lang-bar w-4/5"></div></div>
                      <div class="lang-line l-7"><div class="lang-bar w-1/2"></div></div>
                    </div>
                  </div>
                  <div class="lang-badge">
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                </div>
              </div>
            )}
            <div class="feature-body">
              <h3 class="feature-title">{feature.title}</h3>
              <p class="feature-desc">{feature.description}</p>
            </div>
          </article>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features-section {
    position: relative;
    overflow: hidden;
    background: #fbfafd;
  }

  .features-atmosphere {
    pointer-events: none;
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 50% 45% at 8% 20%, rgba(var(--dn-primary-rgb), 0.12), transparent 58%),
      radial-gradient(ellipse 42% 40% at 92% 78%, rgba(var(--dn-primary-end-rgb), 0.08), transparent 55%),
      radial-gradient(ellipse 28% 26% at 55% 6%, rgba(var(--dn-primary-mid-rgb), 0.07), transparent 50%),
      linear-gradient(180deg, #ffffff 0%, #f5f9ff 48%, #ffffff 100%);
  }

  .features-atmosphere.dn-bg-grid::before {
    background-size: 36px 36px;
  }

  .features-badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--dn-primary);
    box-shadow: 0 0 0 3px rgba(var(--dn-primary-rgb), 0.18);
  }

  .features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    align-items: stretch;
  }

  @media (min-width: 768px) {
    .features-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .features-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .features-grid--2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: 44rem;
    }

    .features-grid--3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .features-grid--4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .feature-card-wrap {
    height: 100%;
    min-height: 100%;
    display: flex;
  }

  .feature-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    min-height: 100%;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 1rem;
    overflow: hidden;
    box-shadow:
      0 1px 2px rgba(15, 23, 42, 0.04),
      0 10px 28px rgba(var(--dn-primary-rgb), 0.05);
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease,
      transform 0.3s ease;
  }

  .feature-card:hover {
    border-color: rgba(var(--dn-primary-mid-rgb), 0.28);
    box-shadow:
      0 4px 12px rgba(15, 23, 42, 0.05),
      0 16px 40px rgba(var(--dn-primary-rgb), 0.1);
    transform: translateY(-2px);
  }

  .feature-viz {
    position: relative;
    flex-shrink: 0;
    height: 10.5rem;
    min-height: 10.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-bottom: 1px solid rgba(15, 23, 42, 0.06);
    background:
      radial-gradient(ellipse 70% 80% at 50% 0%, rgba(var(--dn-primary-rgb), 0.07), transparent 65%),
      linear-gradient(180deg, #fafbff 0%, #ffffff 100%);
  }

  .feature-viz:not(.feature-viz--flat)::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, rgba(15, 23, 42, 0.025) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(15, 23, 42, 0.025) 1px, transparent 1px);
    background-size: 24px 24px;
    background-position: center top;
    -webkit-mask-image: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.6) 0%,
      rgba(0, 0, 0, 0.28) 45%,
      transparent 100%
    );
    mask-image: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.6) 0%,
      rgba(0, 0, 0, 0.28) 45%,
      transparent 100%
    );
  }

  .feature-viz > * {
    position: relative;
    z-index: 1;
  }

  .feature-viz--flat {
    background: #fff;
  }

  .feature-viz--flat::before {
    content: none;
  }

  .feature-body {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    padding: 1.25rem 1.35rem 1.4rem;
    min-height: 0;
  }

  .feature-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: #111827;
    letter-spacing: -0.01em;
    margin-bottom: 0.4rem;
  }

  .feature-desc {
    flex: 1 1 auto;
    font-size: 0.875rem;
    color: #6b7280;
    line-height: 1.6;
  }

  /* ── Card 1: Smart Recording ── */
  .record-demo {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .record-idle {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    transition: opacity 0.35s ease, transform 0.35s ease;
  }

  .record-rings {
    position: absolute;
    inset: 50% auto auto 50%;
    width: 0;
    height: 0;
    transform: translate(-50%, calc(-50% - 10px));
    pointer-events: none;
  }

  .record-ring {
    position: absolute;
    left: 50%;
    top: 50%;
    border-radius: 50%;
    border: 1.5px solid rgba(var(--dn-primary-mid-rgb), 0.22);
    transform: translate(-50%, -50%) scale(0.85);
    opacity: 0;
    animation: ring-pulse 2.8s cubic-bezier(0.22, 1, 0.36, 1) infinite;
  }

  .record-ring.r1 { width: 72px; height: 72px; animation-delay: 0s; }
  .record-ring.r2 { width: 96px; height: 96px; animation-delay: 0.45s; border-color: rgba(var(--dn-primary-rgb), 0.16); }
  .record-ring.r3 { width: 120px; height: 120px; animation-delay: 0.9s; border-color: rgba(var(--dn-primary-end-rgb), 0.12); }

  @keyframes ring-pulse {
    0% { transform: translate(-50%, -50%) scale(0.82); opacity: 0; }
    18% { opacity: 0.7; }
    70% { opacity: 0.15; }
    100% { transform: translate(-50%, -50%) scale(1.18); opacity: 0; }
  }

  .record-btn-dot {
    position: relative;
    z-index: 1;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: mic-breathe 2.8s ease-in-out infinite;
  }

  @keyframes mic-breathe {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.04); }
  }

  .record-wave {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 18px;
    z-index: 1;
  }

  .record-wave span {
    width: 3px;
    border-radius: 2px;
    background: linear-gradient(180deg, var(--dn-primary), var(--dn-primary-mid));
    opacity: 0.55;
    animation: wave-bar 1.1s ease-in-out infinite;
  }

  .record-wave span:nth-child(1) { height: 6px; animation-delay: 0s; }
  .record-wave span:nth-child(2) { height: 12px; animation-delay: 0.1s; }
  .record-wave span:nth-child(3) { height: 9px; animation-delay: 0.2s; }
  .record-wave span:nth-child(4) { height: 16px; animation-delay: 0.05s; }
  .record-wave span:nth-child(5) { height: 8px; animation-delay: 0.25s; }
  .record-wave span:nth-child(6) { height: 13px; animation-delay: 0.15s; }
  .record-wave span:nth-child(7) { height: 7px; animation-delay: 0.3s; }

  @keyframes wave-bar {
    0%, 100% { transform: scaleY(0.55); opacity: 0.35; }
    50% { transform: scaleY(1); opacity: 0.85; }
  }

  .transcript-ui {
    position: absolute;
    inset: 12px 16px 14px;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.35s ease 0.05s, transform 0.35s ease 0.05s;
    display: flex;
    flex-direction: column;
    gap: 8px;
    pointer-events: none;
    min-width: 0;
    overflow: visible;
  }

  .transcript-header {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .transcript-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
    background: var(--dn-primary-mid);
    box-shadow: 0 0 0 0 rgba(var(--dn-primary-mid-rgb), 0.4);
  }

  .transcript-status {
    font-size: 11px;
    font-weight: 600;
    color: var(--dn-primary-ink);
    white-space: nowrap;
  }

  .transcript-timer {
    font-size: 11px;
    color: #9ca3af;
    font-family: ui-monospace, monospace;
    margin-left: auto;
    flex-shrink: 0;
  }

  .transcript-words {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 0;
    font-size: 12.5px;
    color: #6b7280;
    line-height: 1.55;
    white-space: normal;
    overflow-wrap: break-word;
    word-wrap: break-word;
    word-break: normal;
    overflow: visible;
  }

  .transcript-typed {
    white-space: normal;
    overflow-wrap: break-word;
    word-wrap: break-word;
  }

  .transcript-caret {
    display: inline-block;
    width: 1.5px;
    height: 0.95em;
    margin-left: 1px;
    vertical-align: -0.1em;
    background: var(--dn-primary-mid);
    border-radius: 1px;
    opacity: 0;
  }

  .is-recording-live .transcript-caret {
    opacity: 1;
    animation: blink 0.8s step-end infinite;
  }

  .is-recording-live .transcript-caret.is-done {
    animation: none;
    opacity: 0.35;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .transcript-scrub {
    flex-shrink: 0;
    position: relative;
    left: auto;
    right: auto;
    bottom: auto;
    height: 2px;
    border-radius: 1px;
    background: rgba(var(--dn-primary-rgb), 0.1);
    overflow: hidden;
    opacity: 0;
  }

  .transcript-scrub::after {
    content: '';
    position: absolute;
    inset: 0;
    width: 0%;
    background: linear-gradient(90deg, var(--dn-primary), var(--dn-primary-mid));
    border-radius: 1px;
  }

  .group:hover .record-idle,
  .is-recording-live .record-idle {
    opacity: 0;
    transform: scale(0.88);
    pointer-events: none;
  }

  .group:hover .transcript-ui,
  .is-recording-live .transcript-ui {
    opacity: 1;
    transform: translateY(0);
  }

  .group:hover .transcript-dot.recording,
  .is-recording-live .transcript-dot.recording {
    animation: pulse-dot 1.2s ease-in-out infinite;
  }

  .group:hover .transcript-scrub,
  .is-recording-live .transcript-scrub {
    opacity: 1;
  }

  .group:hover .transcript-scrub::after,
  .is-recording-live .transcript-scrub::after {
    animation: scrub-fill 2.2s ease forwards;
  }

  @keyframes scrub-fill {
    from { width: 0%; }
    to { width: 72%; }
  }

  @keyframes pulse-dot {
    0%, 100% {
      opacity: 1;
      box-shadow: 0 0 0 0 rgba(var(--dn-primary-mid-rgb), 0.45);
    }
    50% {
      opacity: 0.55;
      box-shadow: 0 0 0 5px rgba(var(--dn-primary-mid-rgb), 0);
    }
  }

  /* ── Card 2: Transcription cascade ── */
  .transcribe-demo {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .transcribe-ui {
    position: absolute;
    inset: 0;
    padding: 22px 24px;
    display: flex;
    flex-direction: column;
    gap: 1px;
    justify-content: center;
    contain: layout paint;
  }

  .transcribe-line {
    font-size: 13px;
    color: #9ca3af;
    line-height: 1.3;
    opacity: 0.45;
    transform: translateX(-4px);
  }

  .animate-correct .transcribe-line {
    animation: line-cascade 0.45s ease forwards;
  }

  .animate-correct .transcribe-line.l1 { animation-delay: 0.05s; }
  .animate-correct .transcribe-line.l2 { animation-delay: 0.22s; }
  .animate-correct .transcribe-line.l3 { animation-delay: 0.4s; }

  @keyframes line-cascade {
    to {
      opacity: 1;
      transform: translateX(0);
      color: #6b7280;
    }
  }

  .tw-correct {
    display: inline-block;
    position: relative;
  }

  .tw-wrong {
    position: absolute;
    left: 0;
    top: 0;
    white-space: nowrap;
    color: #9ca3af;
  }

  .tw-right {
    color: var(--dn-primary-ink);
    font-weight: 600;
    opacity: 0;
    background: rgba(var(--dn-primary-rgb), 0.1);
    border-radius: 3px;
    padding: 0 2px;
  }

  .animate-correct .tw-wrong {
    animation: wrong-hide 0.45s ease 1.05s forwards;
  }

  .animate-correct .tw-right {
    animation: right-show 0.45s ease 1.2s forwards;
  }

  .animate-correct .transcribe-line.l3 .tw-wrong {
    animation-delay: 1.55s;
  }

  .animate-correct .transcribe-line.l3 .tw-right {
    animation-delay: 1.7s;
  }

  @keyframes wrong-hide {
    from { opacity: 1; transform: translateY(0); }
    to { opacity: 0; transform: translateY(-3px); }
  }

  @keyframes right-show {
    from { opacity: 0; transform: translateY(3px); }
    to { opacity: 1; transform: translateY(0); }
  }

