---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../ui/PageHero.astro';
import { getCareersAlternatePaths, getCareersJobPath, type Locale } from '../../utils/i18n';
import { getCareersCopy, getCareerVacancies } from '../../utils/careers';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getCareersCopy(locale);
const vacancies = getCareerVacancies(t);
const vacanciesCountLabel = t.vacanciesCount.replace('{n}', String(vacancies.length));
const alternates = getCareersAlternatePaths();
---

<Layout title={t.metaTitle} description={t.pageSub} alternates={alternates}>
  <PageHero eyebrow={t.heroEyebrow} title={t.pageTitle} subtitle={t.pageSub}>
    <a href="#open-roles" class="btn-primary">
      {t.heroCta}
    </a>
  </PageHero>

  <section class="py-16 sm:py-20 border-b border-gray-100" aria-labelledby="why-heading">
    <div class="max-w-6xl mx-auto px-6 sm:px-8">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-14 items-start">
        <div class="lg:col-span-5 reveal">
          <h2 id="why-heading" class="text-3xl font-bold text-gray-900 tracking-tight mb-4">{t.whyTitle}</h2>
          <p class="text-gray-600 leading-relaxed text-lg">{t.whyBody}</p>
        </div>
        <ul class="lg:col-span-7 space-y-4 reveal reveal-delay-1">
          {t.whyPoints.map((point) => (
            <li class="flex gap-3 rounded-2xl border border-gray-200 bg-white p-5 shadow-sm">
              <span class="mt-1.5 h-2 w-2 rounded-full bg-violet-500 shrink-0" aria-hidden="true"></span>
              <span class="text-gray-700 leading-relaxed">{point}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20 bg-gradient-to-b from-white to-violet-50/40" aria-labelledby="culture-heading">
    <div class="max-w-6xl mx-auto px-6 sm:px-8">
      <div class="max-w-3xl mb-10 reveal">
        <h2 id="culture-heading" class="text-3xl font-bold text-gray-900 tracking-tight mb-4">{t.cultureTitle}</h2>
        <p class="text-lg text-gray-600 leading-relaxed">{t.cultureBody}</p>
      </div>
      <div class="reveal reveal-delay-1">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-violet-600 mb-5">{t.benefitsTitle}</h3>
        <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {t.benefits.map((item) => (
            <li class="rounded-2xl border border-violet-100 bg-white/80 backdrop-blur px-5 py-5 text-gray-700 leading-relaxed shadow-sm">
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="open-roles" class="py-16 sm:py-20" aria-labelledby="roles-heading">
    <div class="max-w-6xl mx-auto px-6 sm:px-8">
      <div class="flex flex-wrap items-end justify-between gap-4 mb-8 reveal">
        <div>
          <h2 id="roles-heading" class="text-3xl font-bold text-gray-900 tracking-tight">{t.rolesTitle}</h2>
          <p class="text-gray-600 mt-2 max-w-2xl">{t.rolesSub}</p>
        </div>
        <span class="inline-flex items-center rounded-full bg-violet-50 border border-violet-100 px-3 py-1 text-xs font-semibold text-violet-700">
          {vacanciesCountLabel}
        </span>
      </div>

      <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 reveal reveal-delay-1">
        {vacancies.map((job) => (
          <li>
            <a
              href={getCareersJobPath(job.id, locale)}
              class="group flex h-full flex-col rounded-2xl border border-gray-200 bg-white p-6 shadow-sm transition hover:border-violet-300 hover:shadow-md hover:shadow-violet-100/50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-violet-500"
            >
              <div class="flex items-start justify-between gap-3 mb-4">
                <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-violet-50 border border-violet-100 text-violet-600">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                  </svg>
                </span>
                <span class="text-xs font-semibold text-violet-700 opacity-0 transition group-hover:opacity-100">
                  {t.viewRole} →
                </span>
              </div>
              <h3 class="text-lg font-bold text-gray-900 mb-2 leading-snug">{job.shortLabel}</h3>
              <p class="text-sm text-gray-600 mb-3 flex-1">{job.location}</p>
              <p class="text-xs font-medium text-violet-700 mb-5">{job.type}</p>
              <span class="inline-flex items-center justify-center rounded-full border border-violet-200 bg-violet-50 px-4 py-2 text-sm font-semibold text-violet-700 transition group-hover:bg-violet-600 group-hover:text-white group-hover:border-violet-600">
                {t.viewRole}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
