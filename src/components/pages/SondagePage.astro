    .field-error { border-color: #f87171 !important; box-shadow: 0 0 0 3px #fecaca !important; }
    .group-error { box-shadow: 0 0 0 2px #fca5a5; border-radius: 1rem; padding: 0.25rem; }
    .gauss-line { stroke-dasharray: 1400; stroke-dashoffset: 1400; animation: gaussdraw 1.1s ease-out forwards; }

    .survey-main {
      min-height: 100svh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding-top: 5.5rem;
      padding-bottom: 3rem;
    }

    .survey-main > .relative {
      width: 100%;
    }

    .survey-screen {
      transition: opacity 0.4s ease, transform 0.4s ease;
    }

    .survey-screen--intro {
      min-height: calc(100svh - 8.5rem);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    .survey-screen--intro.hidden {
      display: none;
    }

    .survey-main:has(.survey-screen:not(.survey-screen--intro):not(.hidden)) {
      justify-content: flex-start;
      padding-top: 7rem;
      padding-bottom: 6rem;
    }
