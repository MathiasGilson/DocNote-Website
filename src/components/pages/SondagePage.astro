---
import Layout from '../../layouts/Layout.astro';
import StoreIcon from '../StoreIcon.astro';
import specialtiesData from '../../data/survey-specialties.json';
import { type Locale, getSurveyAlternatePaths } from '../../utils/i18n';
import { absoluteUrl } from '../../utils/seo';
import { sondageCopy, getInline } from '../../utils/inline-content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const lang = locale;

type SpecialtyRow = { value: string; fr: string; en: string; de: string } & Record<string, string>;
const SPECIALTIES = (specialtiesData as SpecialtyRow[]).map((s) => ({
  value: s.value,
  label: s[lang] || s.en,
  fr: s.fr,
}));

const APP_WEB = 'https://docnote.care/app';
const APP_IOS = 'https://apps.apple.com/ch/app/docnote-for-doctors/id6741168204?l=fr-FR';
const APP_ANDROID = 'https://play.google.com/store/apps/details?id=app.docnote&pli=1';
const VIDEO_ID = lang === 'fr' ? 'xnKpex2jtgs' : 'DdQ_POkaaPE';
const WEB3FORMS_KEY = import.meta.env.PUBLIC_WEB3FORMS_KEY || '0303b631-a251-46e1-b144-b4f83418d5ae';

const S = getInline(sondageCopy, lang) as typeof sondageCopy.en;
const surveyAlternates = Object.fromEntries(
  Object.entries(getSurveyAlternatePaths()).map(([code, path]) => [code, absoluteUrl(path)])
) as Record<Locale, string>;

const QUESTION_STEPS = 3;
---

<Layout title={S.metaTitle} description={S.metaDescription} alternates={surveyAlternates}>
  <div class="survey-page min-h-screen">
    <div
      id="survey-progress-wrap"
      class="survey-progress-wrap fixed top-0 left-0 right-0 z-40 hidden"
      role="progressbar"
      aria-label={S.progressLabel}
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
    >
      <div id="survey-progress" class="survey-progress-bar" style="width:0%"></div>
    </div>

    <section class="survey-main relative px-4 sm:px-6 bg-white">
      <div class="relative max-w-2xl mx-auto w-full">
        <p
          id="survey-step-label"
          class="survey-step-label hidden text-center text-sm font-semibold tracking-wide mb-6"
          aria-live="polite"
        ></p>

        <!-- SCREEN 1 - Intro -->
        <div data-screen="1" class="survey-screen survey-screen--intro">
          <div class="text-center survey-reveal">
            <p class="dn-page-hero__eyebrow mb-8">
              <span class="dn-page-hero__dot" aria-hidden="true"></span>
              {S.badge}
            </p>
            <h1 class="dn-page-hero__title mb-6">
              {S.h1}
            </h1>
            <p class="text-lg text-gray-600 mb-10 max-w-lg mx-auto leading-relaxed">{S.intro}</p>
            <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6 text-gray-700 mb-10">
              <div class="survey-chip">
                <svg class="w-5 h-5" style="color:var(--dn-primary-mid)" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span class="font-medium">{S.twoMin}</span>
              </div>
              <div class="survey-chip">
                <svg class="w-5 h-5" style="color:var(--dn-primary-mid)" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                <span class="font-medium">{S.anonymous}</span>
              </div>
            </div>
            <button type="button" data-next class="btn-primary btn-primary-lg font-semibold">
              {S.start}
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            </button>
          </div>
        </div>

        <!-- SCREEN 2 - Profile -->
        <div data-screen="2" class="survey-screen hidden">
          <div class="survey-card survey-reveal">
            <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2 tracking-tight">{S.profileTitle}</h2>
            <p class="text-gray-500 mb-8 leading-relaxed">{S.profileSub}</p>

            <div class="space-y-7">
              <div>
                <span class="survey-label" id="label-survey-specialty">{S.specialty} <span class="survey-req" aria-hidden="true">*</span></span>
                <div
                  class="dn-select"
                  data-select
                  data-answer="specialty"
                  data-required
                  data-placeholder={S.specialtyPlaceholder}
                  aria-labelledby="label-survey-specialty"
                >
                  <button
                    type="button"
                    id="survey-specialty"
                    class="dn-select-trigger field"
                    aria-haspopup="listbox"
                    aria-expanded="false"
                    aria-labelledby="label-survey-specialty"
                  >
                    <span class="dn-select-value text-gray-400">{S.specialtyPlaceholder}</span>
                    <svg class="dn-select-chevron" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"/></svg>
                  </button>
                  <ul class="dn-select-menu hidden" role="listbox" tabindex="-1" aria-labelledby="label-survey-specialty">
                    {SPECIALTIES.map((s) => (
                      <li role="option" data-value={s.value} class="dn-select-option" aria-selected="false" tabindex="-1">{s.label}</li>
                    ))}
                  </ul>
                  <input type="hidden" data-answer="specialty" data-required value="" autocomplete="organization-title" />
                </div>
              </div>

              <div>
                <label for="survey-age" class="survey-label">{S.age} <span class="survey-req" aria-hidden="true">*</span></label>
                <input id="survey-age" type="number" min="20" max="99" inputmode="numeric" data-answer="age" data-required placeholder={S.agePlaceholder} class="field" />
              </div>

              <fieldset>
                <legend class="survey-label">{S.gender} <span class="survey-req" aria-hidden="true">*</span></legend>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3" data-group="gender" data-required role="group" aria-label={S.gender}>
                  <button type="button" data-value="homme" class="opt">{S.genderMale}</button>
                  <button type="button" data-value="femme" class="opt">{S.genderFemale}</button>
                  <button type="button" data-value="autre" class="opt">{S.genderOther}</button>
                </div>
              </fieldset>

              <fieldset>
                <legend class="survey-label">{S.position} <span class="survey-req" aria-hidden="true">*</span></legend>
                <div class="grid grid-cols-2 gap-3" data-group="position" data-required role="group" aria-label={S.position}>
                  <button type="button" data-value="interne" class="opt">{S.posResident}</button>
                  <button type="button" data-value="chef_clinique" class="opt">{S.posChief}</button>
                  <button type="button" data-value="adjoint" class="opt">{S.posAttending}</button>
                  <button type="button" data-value="chef_service" class="opt">{S.posHead}</button>
                </div>
              </fieldset>

              <fieldset>
                <legend class="survey-label">{S.facility} <span class="survey-req" aria-hidden="true">*</span></legend>
                <div class="grid grid-cols-2 gap-3" data-group="facility" data-required role="group" aria-label={S.facility}>
                  <button type="button" data-value="hopital_universitaire" class="opt">{S.facUniversity}</button>
                  <button type="button" data-value="hopital_peripherique" class="opt">{S.facRegional}</button>
                  <button type="button" data-value="prive_clinique" class="opt">{S.facPrivate}</button>
                  <button type="button" data-value="cabinet" class="opt">{S.facPractice}</button>
                </div>
              </fieldset>
            </div>

            <p data-error class="survey-error mt-6 hidden" role="alert">{S.errAll}</p>
            <div class="survey-nav">
              <button type="button" data-back class="btn-back">{S.back}</button>
              <button type="button" data-next class="btn-next">{S.continue}</button>
            </div>
          </div>
        </div>

        <!-- SCREEN 3 - Burden -->
        <div data-screen="3" class="survey-screen hidden">
          <div class="survey-card survey-reveal">
            <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-8 tracking-tight">{S.burdenTitle}</h2>

            <div class="space-y-9">
              <fieldset>
                <legend class="survey-label mb-3">{S.methodQ} <span class="survey-req" aria-hidden="true">*</span></legend>
                <div class="space-y-3" data-group="method" data-required role="group" aria-label={S.methodQ}>
                  <button type="button" data-value="papier_puis_ordi" class="opt opt-wide">{S.methodPaper}</button>
                  <button type="button" data-value="ordi_pendant" class="opt opt-wide">{S.methodComputer}</button>
                  <button type="button" data-value="note_puis_dictee" class="opt opt-wide">{S.methodNoteDictation}</button>
                  <button type="button" data-value="dictee_sans_note" class="opt opt-wide">{S.methodDictation}</button>
                  <button type="button" data-value="autre" class="opt opt-wide">{S.methodOther}</button>
                </div>
                <input type="text" data-answer="methodOther" placeholder={S.methodOtherPlaceholder} class="field mt-3 hidden" data-other-for="method" />
              </fieldset>

              <div>
                <label for="survey-time" class="survey-label mb-4">{S.timeQ}</label>
                <div class="survey-range-wrap px-1">
                  <input id="survey-time" type="range" min="0" max="45" value="12" step="1" data-answer="time" class="survey-range" aria-valuetext="12 min" />
                  <div class="flex justify-between text-xs text-gray-400 mt-3">
                    <span>0 min</span>
                    <span id="time-val" class="survey-range-value">12 min</span>
                    <span>45 min</span>
                  </div>
                </div>
              </div>

              <div>
                <label for="survey-impact" class="survey-label mb-4">{S.impactQ}</label>
                <div class="survey-range-wrap px-1">
                  <input id="survey-impact" type="range" min="0" max="10" value="5" data-answer="impact" class="survey-range" aria-valuetext="5 / 10" />
                  <div class="flex justify-between text-xs text-gray-400 mt-3">
                    <span>{S.impactNone}</span>
                    <span id="impact-val" class="survey-range-value">5 / 10</span>
                    <span>{S.impactMajor}</span>
                  </div>
                </div>
              </div>

              <fieldset>
                <legend class="survey-label mb-3">{S.overtimeQ} <span class="survey-req" aria-hidden="true">*</span></legend>
                <div class="grid grid-cols-2 sm:grid-cols-5 gap-3" data-group="overtime" data-required role="group" aria-label={S.overtimeQ}>
                  <button type="button" data-value="0" class="opt">0 h</button>
                  <button type="button" data-value="1" class="opt">&lt; 2 h</button>
                  <button type="button" data-value="2" class="opt">2-5 h</button>
                  <button type="button" data-value="3" class="opt">5-10 h</button>
                  <button type="button" data-value="4" class="opt">&gt; 10 h</button>
                </div>
              </fieldset>
            </div>

            <p data-error class="survey-error mt-6 hidden" role="alert">{S.errAll}</p>
            <div class="survey-nav">
              <button type="button" data-back class="btn-back">{S.back}</button>
              <button type="button" data-next class="btn-next">{S.seeResults}</button>
            </div>
          </div>
        </div>

        <!-- SCREEN 4 - Contact -->
        <div data-screen="4" class="survey-screen hidden">
          <div class="survey-card survey-reveal">
            <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2 tracking-tight">{S.contactTitle}</h2>
            <p class="text-gray-500 mb-8 leading-relaxed">{S.contactSub}</p>

            <div class="space-y-5">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="survey-first" class="survey-label">{S.firstName} <span class="survey-req" aria-hidden="true">*</span></label>
                  <input id="survey-first" type="text" data-answer="firstName" data-required autocomplete="given-name" class="field" />
                </div>
                <div>
                  <label for="survey-last" class="survey-label">{S.lastName} <span class="survey-req" aria-hidden="true">*</span></label>
                  <input id="survey-last" type="text" data-answer="lastName" data-required autocomplete="family-name" class="field" />
                </div>
              </div>
              <div>
                <label for="survey-email" class="survey-label">{S.emailLabel} <span class="survey-req" aria-hidden="true">*</span></label>
                <input id="survey-email" type="email" data-answer="email" data-required autocomplete="email" placeholder={S.emailPlaceholder} class="field" />
              </div>
              <div>
                <span class="survey-label">{S.phoneLabel} <span class="survey-req" aria-hidden="true">*</span></span>
                <div class="flex gap-3">
                  <div
                    class="dn-select field-code"
                    data-select
                    data-answer="phoneCode"
                    aria-label={S.phoneCodeLabel}
                  >
                    <button
                      type="button"
                      id="survey-phone-code"
                      class="dn-select-trigger field"
                      aria-haspopup="listbox"
                      aria-expanded="false"
                      aria-label={S.phoneCodeLabel}
                    >
                      <span class="dn-select-value text-gray-900">🇨🇭 +41</span>
                      <svg class="dn-select-chevron" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"/></svg>
                    </button>
                    <ul class="dn-select-menu hidden" role="listbox" tabindex="-1" aria-label={S.phoneCodeLabel}>
                      <li role="option" data-value="+41" class="dn-select-option" aria-selected="true" tabindex="-1">🇨🇭 +41</li>
                      <li role="option" data-value="+33" class="dn-select-option" aria-selected="false" tabindex="-1">🇫🇷 +33</li>
                      <li role="option" data-value="+32" class="dn-select-option" aria-selected="false" tabindex="-1">🇧🇪 +32</li>
                      <li role="option" data-value="+49" class="dn-select-option" aria-selected="false" tabindex="-1">🇩🇪 +49</li>
                      <li role="option" data-value="+352" class="dn-select-option" aria-selected="false" tabindex="-1">🇱🇺 +352</li>
                      <li role="option" data-value="+39" class="dn-select-option" aria-selected="false" tabindex="-1">🇮🇹 +39</li>
                    </ul>
                    <input type="hidden" data-answer="phoneCode" value="+41" />
                  </div>
                  <input id="survey-phone" type="tel" data-answer="phone" data-required autocomplete="tel" placeholder={S.phonePlaceholder} class="field flex-1" aria-label={S.phoneLabel} />
                </div>
              </div>
              <p data-error class="survey-error hidden" role="alert">{S.errContact}</p>
            </div>

            <p class="survey-privacy mt-6">
              <svg class="w-4 h-4 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
              {S.privacy}
            </p>

            <div class="survey-nav">
              <button type="button" data-back class="btn-back">{S.back}</button>
              <button type="button" data-next class="btn-next">{S.revealIndex}</button>
            </div>
          </div>
        </div>

        <!-- SCREEN 5 - Results -->
        <div data-screen="5" class="survey-screen hidden">
          <div class="survey-reveal">
            <div class="text-center mb-10">
              <div class="survey-success-icon mx-auto mb-5" aria-hidden="true">
                <svg class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              </div>
              <p class="text-sm font-semibold uppercase tracking-wider mb-2" style="color:var(--dn-primary-mid)">{S.resultsReady}</p>
              <p class="text-sm font-semibold uppercase tracking-wider mb-3 text-gray-400">{S.indexLabel}</p>
              <div class="text-7xl sm:text-8xl font-bold text-gradient mb-3 leading-none">
                <span id="score-value">0</span><span class="text-3xl text-gray-400 font-semibold">/100</span>
              </div>
              <p id="score-label" class="text-lg text-gray-700 font-medium"></p>
            </div>

            <div class="survey-result-card mb-6">
              <h3 class="text-base font-semibold text-gray-900 mb-1">{S.whereStand}</h3>
              <p id="percentile-text" class="text-sm text-gray-500 mb-4"></p>
              <div id="gauss-chart" class="w-full"></div>
            </div>

            <div class="survey-result-card mb-10">
              <h3 class="text-base font-semibold text-gray-900 mb-1">{S.timePerConsult}</h3>
              <p id="time-caption" class="text-sm text-gray-500 mb-4"></p>
              <div id="time-chart" class="w-full"></div>
            </div>

            <div class="survey-demo-card">
              <div class="text-center mb-7">
                <h3 class="text-2xl font-bold text-slate-900 mb-2 tracking-tight">{S.demoTitle}</h3>
                <p class="text-slate-600 leading-relaxed">{S.demoPrefix}<span id="demo-spec-label" class="font-semibold" style="color:var(--dn-primary-mid)">{S.demoSpecDefault}</span>{S.demoSuffix}</p>
              </div>

              <div class="mx-auto overflow-hidden rounded-2xl shadow-lg bg-slate-900" style="max-width:640px;">
                <div class="relative w-full" style="aspect-ratio:16/9;">
                  <iframe
                    class="absolute inset-0 h-full w-full"
                    src={`https://www.youtube.com/embed/${VIDEO_ID}`}
                    title={S.videoTitle}
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen
                    loading="lazy"
                  ></iframe>
                </div>
              </div>

              <div id="onboarding-cta" class="mt-8 text-center">
                <p class="text-gray-700 mb-1 font-medium">{S.accountPreconfigured}</p>
                <p class="text-gray-500 text-sm mb-5">{S.accountSub}</p>
                <div class="flex flex-col sm:flex-row gap-3 justify-center">
                  <a id="cta-web" href={APP_WEB} target="_blank" rel="noopener noreferrer" class="btn-primary font-semibold">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.6 9h16.8M3.6 15h16.8M12 3a15 15 0 010 18M12 3a15 15 0 000 18"/></svg>
                    {S.launchWebApp}
                  </a>
                  <a id="cta-ios" href={APP_IOS} target="_blank" rel="noopener noreferrer" class="survey-store-btn">
                    <StoreIcon store="apple" class="w-4 h-4" />
                    App Store
                  </a>
                  <a id="cta-android" href={APP_ANDROID} target="_blank" rel="noopener noreferrer" class="survey-store-btn">
                    <StoreIcon store="google" class="w-4 h-4" />
                    Google Play
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <style>
    .survey-page {
      background: #fff;
    }
    .survey-progress-wrap {
      height: 3px;
      background: rgba(var(--dn-primary-mid-rgb), 0.12);
    }
    .survey-progress-bar {
      height: 100%;
      background-image: var(--dn-gradient);
      transition: width 0.55s cubic-bezier(0.22, 1, 0.36, 1);
      box-shadow: 0 0 12px rgba(var(--dn-primary-mid-rgb), 0.45);
    }
    .survey-step-label {
      color: var(--dn-primary-ink);
    }
    .survey-badge {
      color: var(--dn-primary-ink);
      background: rgba(var(--dn-primary-rgb), 0.1);
      border: 1px solid rgba(var(--dn-primary-mid-rgb), 0.22);
      border-radius: 9999px;
      box-shadow: 0 8px 22px rgba(var(--dn-primary-rgb), 0.1);
    }
    .survey-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.55rem 1rem;
      border-radius: 9999px;
      background: rgba(255, 255, 255, 0.75);
      border: 1px solid rgba(var(--dn-primary-mid-rgb), 0.14);
      backdrop-filter: blur(6px);
    }
    .survey-card,
    .survey-result-card,
    .survey-demo-card {
      background: rgba(255, 255, 255, 0.92);
      border: 1px solid rgba(var(--dn-primary-mid-rgb), 0.1);
      border-radius: 1.5rem;
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.8) inset,
        0 10px 28px rgba(var(--dn-primary-rgb), 0.06);
      padding: 1.75rem;
    }
    @media (min-width: 640px) {
      .survey-card,
      .survey-demo-card { padding: 2.25rem; }
      .survey-result-card { padding: 1.75rem; }
    }
    .survey-demo-card {
      background:
        radial-gradient(ellipse 70% 80% at 50% 0%, rgba(var(--dn-primary-rgb), 0.08), transparent 65%),
        #f8fafc;
      border-color: rgba(148, 163, 184, 0.25);
    }
    .survey-label {
      display: block;
      font-size: 0.875rem;
      font-weight: 600;
      color: #374151;
      margin-bottom: 0.5rem;
    }
    .survey-req { color: var(--dn-primary-mid); }
    .survey-error { font-size: 0.875rem; color: #ef4444; }
    .survey-privacy {
      display: flex;
      align-items: flex-start;
      gap: 0.5rem;
      font-size: 0.75rem;
      color: #9ca3af;
      line-height: 1.45;
    }
    .survey-nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 2rem;
      gap: 1rem;
    }
    .survey-range-value {
      font-weight: 700;
      font-size: 1rem;
      color: var(--dn-primary-ink);
    }
    .survey-success-icon {
      width: 3.25rem;
      height: 3.25rem;
      border-radius: 9999px;
      display: flex;
      align-items: center;
      justify-content: center;
      background-image: var(--dn-gradient);
      box-shadow: var(--dn-glow);
