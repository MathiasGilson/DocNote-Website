---
import Layout from '../../layouts/Layout.astro';
import type { Locale } from '../../utils/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const lang = locale as Locale;

// Boîte de réception : le compte Web3Forms est rattaché à contact@docnote.ch.
// Même clé que la page sondage ; surchargeable par PUBLIC_WEB3FORMS_KEY.
const WEB3FORMS_KEY = import.meta.env.PUBLIC_WEB3FORMS_KEY || '0303b631-a251-46e1-b144-b4f83418d5ae';

const STRINGS = {
  fr: {
    metaTitle: 'Demander une démo | DocNote',
    metaDescription:
      "Demandez une démonstration de DocNote. Laissez-nous vos coordonnées, nous vous recontactons pour convenir d'un créneau.",
    eyebrow: 'Démonstration',
    pageTitle: 'Demander une démo',
    pageSub:
      'Laissez-nous vos coordonnées : nous vous recontactons rapidement pour convenir d’un créneau et adapter la démonstration à votre pratique.',
    sectionContact: 'Vos coordonnées',
    sectionContext: 'Votre pratique',
    firstName: 'Prénom',
    lastName: 'Nom',
    email: 'E-mail',
    phone: 'Téléphone',
    role: 'Rôle',
    facility: 'Établissement',
    facilityHint: 'Hôpital, clinique, cabinet…',
    message: 'Commentaire',
    messageHint: 'Facultatif — dites-nous ce que vous aimeriez voir pendant la démonstration.',
    selectPlaceholder: 'Sélectionnez…',
    roleDoctor: 'Médecin',
    roleSecretary: 'Secrétariat',
    roleManagement: 'Direction / administration',
    roleOther: 'Autre',
    submit: 'Envoyer ma demande',
    submitting: 'Envoi…',
    successTitle: 'Demande envoyée',
    successBody: 'Merci ! Notre équipe vous recontacte sous 48 heures ouvrées pour convenir d’un créneau.',
    errRequired: 'Merci de remplir tous les champs obligatoires.',
    errEmail: 'Merci d’indiquer une adresse e-mail valide.',
    errNetwork: 'L’envoi a échoué. Réessayez, ou écrivez-nous à contact@docnote.ch.',
    errConfig: 'Le formulaire n’est pas configuré. Écrivez-nous à contact@docnote.ch.',
  },
  en: {
    metaTitle: 'Get a demo | DocNote',
    metaDescription:
      'Request a DocNote demo. Leave us your details and we will get back to you to arrange a time.',
    eyebrow: 'Demo',
    pageTitle: 'Get a demo',
    pageSub:
      'Leave us your details and we will get back to you shortly to arrange a time and tailor the demo to your practice.',
    sectionContact: 'Your details',
    sectionContext: 'Your practice',
    firstName: 'First name',
    lastName: 'Last name',
    email: 'Email',
    phone: 'Phone',
    role: 'Role',
    facility: 'Organisation',
    facilityHint: 'Hospital, clinic, private practice…',
    message: 'Comment',
    messageHint: 'Optional — tell us what you would like to see during the demo.',
    selectPlaceholder: 'Select…',
    roleDoctor: 'Doctor',
    roleSecretary: 'Administrative staff',
    roleManagement: 'Management / administration',
    roleOther: 'Other',
    submit: 'Send my request',
    submitting: 'Sending…',
    successTitle: 'Request sent',
    successBody: 'Thank you! Our team will get back to you within two business days to arrange a time.',
    errRequired: 'Please fill in every required field.',
    errEmail: 'Please enter a valid email address.',
    errNetwork: 'Sending failed. Please try again, or email us at contact@docnote.ch.',
    errConfig: 'This form is not configured. Please email us at contact@docnote.ch.',
  },
  de: {
    metaTitle: 'Demo anfordern | DocNote',
    metaDescription:
      'Fordern Sie eine DocNote-Demo an. Hinterlassen Sie uns Ihre Kontaktdaten, wir melden uns für einen Termin.',
    eyebrow: 'Demo',
    pageTitle: 'Demo anfordern',
    pageSub:
      'Hinterlassen Sie uns Ihre Kontaktdaten: Wir melden uns zeitnah, um einen Termin zu vereinbaren und die Demo auf Ihre Praxis abzustimmen.',
    sectionContact: 'Ihre Kontaktdaten',
    sectionContext: 'Ihre Tätigkeit',
    firstName: 'Vorname',
    lastName: 'Name',
    email: 'E-Mail',
    phone: 'Telefon',
    role: 'Funktion',
    facility: 'Einrichtung',
    facilityHint: 'Spital, Klinik, Praxis…',
    message: 'Kommentar',
    messageHint: 'Optional — sagen Sie uns, was Sie in der Demo sehen möchten.',
    selectPlaceholder: 'Bitte wählen…',
    roleDoctor: 'Ärztin / Arzt',
    roleSecretary: 'Sekretariat',
    roleManagement: 'Leitung / Verwaltung',
    roleOther: 'Andere',
    submit: 'Anfrage senden',
    submitting: 'Wird gesendet…',
    successTitle: 'Anfrage gesendet',
    successBody: 'Vielen Dank! Unser Team meldet sich innerhalb von zwei Arbeitstagen für einen Termin.',
    errRequired: 'Bitte füllen Sie alle Pflichtfelder aus.',
    errEmail: 'Bitte geben Sie eine gültige E-Mail-Adresse an.',
    errNetwork: 'Das Senden ist fehlgeschlagen. Bitte erneut versuchen oder an contact@docnote.ch schreiben.',
    errConfig: 'Dieses Formular ist nicht konfiguriert. Bitte schreiben Sie an contact@docnote.ch.',
  },
} as const;

const t = STRINGS[lang];

// La valeur envoyée par e-mail reste en français : la boîte contact@ est traitée en français.
const roleOptions = [
  { value: 'Médecin', label: t.roleDoctor },
  { value: 'Secrétariat', label: t.roleSecretary },
  { value: 'Direction / administration', label: t.roleManagement },
  { value: 'Autre', label: t.roleOther },
] as const;

const inputClass =
  'mt-1.5 w-full rounded-lg border border-gray-300 px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-violet-500 focus:border-transparent';
---

<Layout title={t.metaTitle} description={t.metaDescription}>
  <section class="pt-28 pb-8 bg-gradient-to-b from-violet-50 via-white to-white">
    <div class="max-w-3xl mx-auto px-6 sm:px-8">
      <p class="text-sm font-semibold uppercase tracking-wider text-violet-600 mb-3">{t.eyebrow}</p>
      <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-4">{t.pageTitle}</h1>
      <p class="text-lg text-gray-600 leading-relaxed">{t.pageSub}</p>
    </div>
  </section>

  <section class="pb-20">
    <div class="max-w-3xl mx-auto px-6 sm:px-8">
      <div id="form-success" class="hidden rounded-xl bg-emerald-50 border border-emerald-200 p-8 text-center">
        <h2 class="text-xl font-bold text-emerald-900 mb-2">{t.successTitle}</h2>
        <p class="text-emerald-800">{t.successBody}</p>
      </div>

      <form id="demo-form" class="space-y-10" novalidate>
        <fieldset class="space-y-4">
          <legend class="text-sm font-semibold uppercase tracking-wider text-violet-600 mb-2">{t.sectionContact}</legend>
          <div class="grid sm:grid-cols-2 gap-4">
            <label class="block">
              <span class="text-sm font-medium text-gray-700">{t.firstName} <span class="text-violet-600">*</span></span>
              <input name="firstName" autocomplete="given-name" required class={inputClass} />
            </label>
            <label class="block">
              <span class="text-sm font-medium text-gray-700">{t.lastName} <span class="text-violet-600">*</span></span>
              <input name="lastName" autocomplete="family-name" required class={inputClass} />
            </label>
          </div>
          <div class="grid sm:grid-cols-2 gap-4">
            <label class="block">
              <span class="text-sm font-medium text-gray-700">{t.email} <span class="text-violet-600">*</span></span>
              <input name="email" type="email" autocomplete="email" required class={inputClass} />
            </label>
            <label class="block">
              <span class="text-sm font-medium text-gray-700">{t.phone} <span class="text-violet-600">*</span></span>
              <input name="phone" type="tel" autocomplete="tel" required class={inputClass} />
            </label>
          </div>
        </fieldset>

        <fieldset class="space-y-4">
          <legend class="text-sm font-semibold uppercase tracking-wider text-violet-600 mb-2">{t.sectionContext}</legend>
          <div class="grid sm:grid-cols-2 gap-4">
            <label class="block">
              <span class="text-sm font-medium text-gray-700">{t.role} <span class="text-violet-600">*</span></span>
              <select name="role" required class={`${inputClass} bg-white`}>
                <option value="">{t.selectPlaceholder}</option>
                {roleOptions.map((option) => <option value={option.value}>{option.label}</option>)}
              </select>
            </label>
            <label class="block">
              <span class="text-sm font-medium text-gray-700">{t.facility} <span class="text-violet-600">*</span></span>
              <input name="facility" required placeholder={t.facilityHint} class={inputClass} />
            </label>
          </div>
          <label class="block">
            <span class="text-sm font-medium text-gray-700">{t.message}</span>
            <textarea name="message" rows="4" maxlength="1200" class={inputClass}></textarea>
            <span class="mt-1 block text-xs text-gray-400">{t.messageHint}</span>
          </label>
        </fieldset>

        <!-- Piège à robots : Web3Forms rejette l'envoi si ce champ est rempli. -->
        <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

        <p id="form-error" class="hidden text-sm text-red-600"></p>

        <button
          type="submit"
          id="submit-btn"
          class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 rounded-lg bg-[#7951fb] text-white font-semibold hover:bg-[#5b3fd4] transition-colors disabled:opacity-60 disabled:cursor-not-allowed"
        >
          {t.submit}
        </button>
      </form>
    </div>
  </section>
</Layout>

<script define:vars={{ WEB3FORMS_KEY, strings: t, LANG: lang, submitLabel: t.submit, submittingLabel: t.submitting }}>
  const form = document.getElementById('demo-form');
  const errorEl = document.getElementById('form-error');
  const successEl = document.getElementById('form-success');
  const submitBtn = document.getElementById('submit-btn');

  const REQUIRED = ['firstName', 'lastName', 'email', 'phone', 'role', 'facility'];

  const showError = (msg) => {
    errorEl.textContent = msg;
    errorEl.classList.remove('hidden');
  };

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorEl.classList.add('hidden');

    if (!WEB3FORMS_KEY) {
      showError(strings.errConfig);
      return;
    }

    const data = Object.fromEntries(new FormData(form).entries());
    for (const field of REQUIRED) {
      if (!String(data[field] || '').trim()) {
        showError(strings.errRequired);
        return;
      }
    }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(data.email))) {
      showError(strings.errEmail);
      return;
    }

    const fullName = `${String(data.firstName).trim()} ${String(data.lastName).trim()}`;
    const facility = String(data.facility).trim();

    submitBtn.disabled = true;
    submitBtn.textContent = submittingLabel;

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          access_key: WEB3FORMS_KEY,
          subject: `🩺 Nouvelle demande de démo — ${fullName} (${facility})`,
          from_name: 'Demande de démo — site DocNote',
          replyto: String(data.email).trim(),
          botcheck: data.botcheck ? 'true' : '',
          Prénom: String(data.firstName).trim(),
          Nom: String(data.lastName).trim(),
          'E-mail': String(data.email).trim(),
          Téléphone: String(data.phone).trim(),
          Rôle: String(data.role),
          Établissement: facility,
          Commentaire: String(data.message || '').trim() || '—',
          'Langue de la page': LANG.toUpperCase(),
          'Envoyé le': new Date().toISOString(),
        }),
      });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);

      form.classList.add('hidden');
      successEl.classList.remove('hidden');
      successEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } catch {
      showError(strings.errNetwork);
      submitBtn.disabled = false;
      submitBtn.textContent = submitLabel;
    }
  });
</script>
