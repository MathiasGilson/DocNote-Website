---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../ui/PageHero.astro';
import TeamMarquee from '../TeamMarquee.astro';
import { type Locale } from '../../utils/i18n';
import { getEntry } from 'astro:content';
import { getPageMeta } from '../../utils/seo';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const entry = await getEntry('pages', locale);
const enEntry = locale === 'en' ? entry : await getEntry('pages', 'en');
const t = entry!.data;
const enTeam = enEntry!.data.team;
const team = {
  ...enTeam,
  ...t.team,
  members: Object.fromEntries(
    Object.keys(enTeam.members).map((key) => {
      const enMember = enTeam.members[key as keyof typeof enTeam.members];
      const locMember = t.team.members?.[key as keyof typeof t.team.members];
      return [
        key,
        {
          name: locMember?.name || enMember.name,
          role: locMember?.role || enMember.role,
          bio: (locMember?.bio && locMember.bio.trim()) || enMember.bio,
        },
      ];
    })
  ) as typeof enTeam.members,
  subtitle: (t.team.subtitle && t.team.subtitle.trim()) || enTeam.subtitle,
  highlightsTitle:
    (t.team as { highlightsTitle?: string }).highlightsTitle?.trim() ||
    enTeam.highlightsTitle ||
    'How we work',
  highlightsLead:
    (t.team as { highlightsLead?: string }).highlightsLead?.trim() ||
    (enTeam as { highlightsLead?: string }).highlightsLead ||
    '',
  highlights:
    (t.team as { highlights?: { title: string; body: string }[] }).highlights ||
    enTeam.highlights ||
    [],
  highlightsClosing:
    (t.team as { highlightsClosing?: string }).highlightsClosing?.trim() ||
    (enTeam as { highlightsClosing?: string }).highlightsClosing ||
    '',
};

const meta = getPageMeta('team', locale);

const highlightIcons = [
  {
    // heart / clinical care
    paths: [
      'M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z',
    ],
  },
  {
    // shield check / privacy
    paths: [
      'M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z',
    ],
  },
  {
    // users / collaboration
    paths: [
      'M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z',
    ],
  },
  {
    // building / hospital rollout
    paths: [
      'M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21',
    ],
  },
];
---

<Layout title={meta.title} description={meta.description}>
  <PageHero eyebrow={team.aboutUs} title={team.title} subtitle={team.subtitle} compact />

  <section class="team-page relative overflow-hidden pb-20 sm:pb-28 bg-white">
    <TeamMarquee locale={locale} />

    {
      team.highlights.length > 0 && (
        <div class="team-highlights mt-16 sm:mt-24">
          <div class="team-highlights__inner max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20">
            <header class="team-highlights__header reveal">
              <h2 class="team-highlights__title">{team.highlightsTitle}</h2>
              {team.highlightsLead && <p class="team-highlights__lead">{team.highlightsLead}</p>}
            </header>

            <div class="team-highlights__list">
              {team.highlights.map((item, i) => {
                const icon = highlightIcons[i % highlightIcons.length];
                return (
                  <article
                    class:list={[
                      'team-highlight',
                      'reveal',
                      `reveal-delay-${Math.min(i + 1, 4)}`,
                      i % 2 === 1 && 'team-highlight--alt',
                    ]}
                  >
                    <div class="team-highlight__icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                        {icon.paths.map((d) => (
                          <path stroke-linecap="round" stroke-linejoin="round" d={d} />
                        ))}
                      </svg>
                    </div>
                    <div class="team-highlight__content">
                      <div class="team-highlight__meta">
                        <span class="team-highlight__index">{String(i + 1).padStart(2, '0')}</span>
                        <h3 class="team-highlight__heading">{item.title}</h3>
                      </div>
                      <div class="team-highlight__body">
                        {item.body.split(/\n\n+/).map((para) => (
                          <p>{para}</p>
                        ))}
                      </div>
                    </div>
                  </article>
                );
              })}
            </div>

            {team.highlightsClosing && (
              <p class="team-highlights__closing reveal">{team.highlightsClosing}</p>
            )}
          </div>
        </div>
      )
    }
  </section>
</Layout>

<style>
  .team-page {
    background: #fff;
  }

  .team-highlights {
    position: relative;
    background:
      radial-gradient(ellipse 80% 50% at 10% 0%, rgba(var(--dn-primary-rgb), 0.08), transparent 55%),
      radial-gradient(ellipse 70% 45% at 90% 100%, rgba(var(--dn-primary-mid-rgb), 0.07), transparent 50%),
      #f8fafc;
    border-top: 1px solid #e8eef7;
    border-bottom: 1px solid #e8eef7;
  }

  .team-highlights__header {
    max-width: 40rem;
    margin-bottom: 3rem;
  }

  .team-highlights__title {
    margin: 0 0 1.25rem;
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #0f172a;
  }

  .team-highlights__lead {
    margin: 0;
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    line-height: 1.7;
    color: #334155;
  }

  .team-highlights__list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .team-highlight {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem 1.5rem;
    align-items: start;
    padding: 1.5rem 1.35rem;
    border-radius: 1.5rem;
    border: 1px solid rgba(148, 163, 184, 0.28);
    background: rgba(255, 255, 255, 0.88);
    box-shadow: 0 10px 28px rgba(15, 23, 42, 0.04);
  }

  @media (min-width: 768px) {
    .team-highlight {
      gap: 1.5rem 1.75rem;
      padding: 1.85rem 1.75rem;
    }

    .team-highlight--alt {
      grid-template-columns: 1fr auto;
    }

    .team-highlight--alt .team-highlight__icon {
      order: 2;
    }

    .team-highlight--alt .team-highlight__content {
      order: 1;
    }
  }

  .team-highlight__icon {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 1rem;
    color: var(--dn-primary-ink);
    background: linear-gradient(145deg, #fff 0%, var(--dn-primary-soft) 100%);
    border: 1px solid var(--dn-primary-soft-border);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.8);
  }

  @media (min-width: 768px) {
    .team-highlight__icon {
      width: 3.75rem;
      height: 3.75rem;
      border-radius: 1.15rem;
    }
  }

  .team-highlight__icon svg {
    width: 1.45rem;
    height: 1.45rem;
  }

  @media (min-width: 768px) {
    .team-highlight__icon svg {
      width: 1.65rem;
      height: 1.65rem;
    }
  }

  .team-highlight__content {
    min-width: 0;
  }

  .team-highlight__meta {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin-bottom: 0.9rem;
  }

  .team-highlight__index {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--dn-primary-ink);
    opacity: 0.7;
  }

  .team-highlight__heading {
    margin: 0;
    font-size: clamp(1.2rem, 2.4vw, 1.5rem);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: #0f172a;
  }

  .team-highlight__body {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .team-highlight__body p {
    margin: 0;
    font-size: 1.02rem;
    line-height: 1.72;
    color: #475569;
  }

  .team-highlights__closing {
    margin: 2.5rem 0 0;
    padding: 1.5rem 1.35rem;
    border-radius: 1.35rem;
    border: 1px solid var(--dn-primary-soft-border);
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.95), var(--dn-primary-soft));
    font-size: clamp(1.05rem, 2vw, 1.15rem);
    line-height: 1.7;
    color: #0f172a;
    font-weight: 500;
  }

  @media (min-width: 768px) {
    .team-highlights__closing {
      padding: 1.75rem 1.85rem;
    }
  }

</style>
