---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../ui/PageHero.astro';
import '../../styles/landing-page.css';
import { getLocalizedPath, type Locale } from '../../utils/i18n';
import { getLandingNavLabel } from '../../content/landings';
import {
  getSpecialtyFamily,
  getSpecialtyFamilyPath,
  specialtyFamilyMeta,
  specialtyFamilySlugs,
  specialtyFamilyIconMarkup,
} from '../../content/specialty-families';
import {
  getSpecialtiesHub,
  SPECIALTIES_HUB_PATH,
  specialtiesHubDeepSlugs,
} from '../../content/hubs';
import { buildBreadcrumbLd, absoluteLocalizedUrl } from '../../utils/seo';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const lang = locale;
const p = getSpecialtiesHub(lang);

const homeLabel = lang === 'fr' ? 'Accueil' : lang === 'de' ? 'Start' : 'Home';
const specialtiesLabel =
  lang === 'fr' ? 'Spécialités' : lang === 'de' ? 'Fachgebiete' : 'Specialties';

const hubPath = SPECIALTIES_HUB_PATH;
const breadcrumbLd = buildBreadcrumbLd([
  { name: 'DocNote', url: absoluteLocalizedUrl('/', lang) },
  { name: specialtiesLabel, url: absoluteLocalizedUrl(hubPath, lang) },
]);

const families = specialtyFamilySlugs.map((slug) => {
  const copy = getSpecialtyFamily(slug, lang);
  const meta = specialtyFamilyMeta[slug];
  return {
    slug,
    href: getLocalizedPath(getSpecialtyFamilyPath(slug), lang),
    label: copy.navLabel,
    blurb: copy.hero.subtitle || copy.navDesc,
    count: meta.specialtyCount,
    icon: specialtyFamilyIconMarkup(slug),
  };
});

const deepLinks = specialtiesHubDeepSlugs.map((slug) => ({
  slug,
  href: getLocalizedPath(`/${slug}`, lang),
  label: getLandingNavLabel(slug, lang),
}));

const primaryHref = getLocalizedPath('/tutorial', lang);
const secondaryHref = getLocalizedPath('/contact', lang);
const countSuffix = lang === 'fr' ? 'spécialités' : 'specialties';
---

<Layout title={p.title} description={p.description} jsonLd={breadcrumbLd}>
  <div class="lp-crumb-bar pt-28 sm:pt-32">
    <nav class="lp-crumb-inner" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center justify-center gap-2">
        <li>
          <a href={getLocalizedPath('/', lang)} class="hover:text-gray-900 transition-colors">{homeLabel}</a>
        </li>
        <li aria-hidden="true">/</li>
        <li class="text-gray-900 font-medium">{specialtiesLabel}</li>
      </ol>
    </nav>
  </div>

  <PageHero
    eyebrow={p.hero.badge}
    title={p.hero.title}
    subtitle={p.hero.subtitle}
    lead={p.hero.lead}
    compact
  >
    <a href={primaryHref} class="btn-primary">{p.cta.primary}</a>
    <a
      href={secondaryHref}
      class="btn-secondary"
    >
      {p.cta.secondary}
    </a>
  </PageHero>

  <p class="lp-stats-line">{p.statsLine}</p>

  <section class="relative py-10 sm:py-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <ul class="hub-stats reveal" aria-label={p.statsLine}>
        {p.stats.map((stat) => (
          <li class="hub-stat">
            <span class="hub-stat-value">{stat.value}</span>
            <span class="hub-stat-label">{stat.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="relative py-14 sm:py-20 lp-section-soft">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-10 sm:mb-12 reveal">
        <span class="lp-eyebrow">
          <span class="lp-dot" aria-hidden="true"></span>
          {p.familiesBadge}
        </span>
        <h2 class="mt-3 text-2xl sm:text-3xl lg:text-4xl font-semibold text-gray-900 leading-snug tracking-tight">
          {p.familiesTitle}
        </h2>
        <p class="mt-3 text-base text-gray-500 leading-relaxed">{p.familiesSubtitle}</p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
        {families.map((family, i) => (
          <a
            href={family.href}
            class:list={[
              'lp-card hub-card reveal',
              i % 3 === 0 && 'reveal-delay-1',
              i % 3 === 1 && 'reveal-delay-2',
              i % 3 === 2 && 'reveal-delay-3',
            ]}
          >
            <span class="hub-card-icon" aria-hidden="true">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={family.icon}
              />
            </span>
            <h3 class="lp-card-title">{family.label}</h3>
            <p class="lp-card-text">{family.blurb}</p>
            <span class="hub-card-meta">{family.count} {countSuffix}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="relative py-14 sm:py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-8 sm:mb-10 reveal">
        <span class="lp-eyebrow">
          <span class="lp-dot" aria-hidden="true"></span>
          {p.deepBadge}
        </span>
        <h2 class="mt-3 text-2xl sm:text-3xl lg:text-4xl font-semibold text-gray-900 leading-snug tracking-tight">
          {p.deepTitle}
        </h2>
        <p class="mt-3 text-base text-gray-500 leading-relaxed">{p.deepSubtitle}</p>
      </div>

      <ul class="flex flex-wrap gap-x-8 gap-y-3 reveal">
        {deepLinks.map((item) => (
          <li>
            <a
              href={item.href}
              class="text-base text-gray-800 hover:text-primary-700 transition-colors underline-offset-2 hover:underline"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="relative py-14 sm:py-20 overflow-hidden lp-section-soft">
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="lp-cta-shell reveal">
        <div class="max-w-xl">
          <h2 class="text-2xl sm:text-3xl font-semibold text-gray-900 leading-snug tracking-tight">
            {p.cta.title}
          </h2>
          <p class="mt-3 text-base text-gray-600 leading-relaxed">{p.cta.body}</p>
          <div class="mt-6 flex flex-col sm:flex-row gap-3">
            <a href={primaryHref} class="btn-primary">{p.cta.primary}</a>
            <a
              href={secondaryHref}
              class="btn-secondary"
            >
              {p.cta.secondary}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hub-stats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .hub-stat {
    text-align: center;
    padding: 1rem 0.75rem;
    border-radius: 1rem;
    border: 1px solid rgba(15, 23, 42, 0.08);
    background: rgba(255, 255, 255, 0.92);
  }

  .hub-stat-value {
    display: block;
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--dn-primary-ink, #3b1f6e);
    line-height: 1.1;
  }

  .hub-stat-label {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #6b7280;
  }

  .hub-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .hub-card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.35rem;
    height: 2.35rem;
    margin-bottom: 0.85rem;
    border-radius: 0.65rem;
    background: rgba(var(--dn-primary-rgb), 0.1);
    color: var(--dn-primary-ink, #3b1f6e);
  }

  .hub-card-meta {
    display: block;
    margin-top: 1rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #9ca3af;
  }

  @media (min-width: 640px) {
    .hub-stat-value {
      font-size: 2rem;
    }
  }
</style>
