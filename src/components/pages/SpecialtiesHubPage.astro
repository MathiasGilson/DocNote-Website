---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../ui/PageHero.astro';
import '../../styles/landing-page.css';
import '../../styles/family-landings.css';
import '../../styles/hub-pages.css';
import { getLocalizedPath, type Locale } from '../../utils/i18n';
import { getLandingNavLabel, getNavGroupLabel } from '../../content/landings';
import { getLandingUi, getSiteUi } from '../../utils/inline-content';
import {
  getSpecialtyFamily,
  getSpecialtyFamilyPath,
  specialtyFamilyMeta,
  specialtyFamilySlugs,
  specialtyFamilyIconMarkup,
} from '../../content/specialty-families';
import { familyVisualCopy, getFamilyVisual } from '../../content/family-visuals';
import {
  getSpecialtiesHub,
  SPECIALTIES_FEATURED_IMAGE,
  SPECIALTIES_HUB_HERO_IMAGE,
  SPECIALTIES_HUB_PATH,
  specialtiesHubDeepSlugs,
} from '../../content/hubs';
import { buildBreadcrumbLd, absoluteLocalizedUrl } from '../../utils/seo';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const lang = locale;
const siteUi = getSiteUi(lang);
const p = getSpecialtiesHub(lang);

const ui = getLandingUi(lang);
const homeLabel = ui.home;
const specialtiesLabel = getNavGroupLabel('specialties', lang);

const hubPath = SPECIALTIES_HUB_PATH;
const breadcrumbLd = buildBreadcrumbLd([
  { name: 'DocNote', url: absoluteLocalizedUrl('/', lang) },
  { name: specialtiesLabel, url: absoluteLocalizedUrl(hubPath, lang) },
]);

const families = specialtyFamilySlugs.map((slug) => {
  const copy = getSpecialtyFamily(slug, lang);
  const meta = specialtyFamilyMeta[slug];
  const visual = getFamilyVisual(slug);
  const { imageAlt } = familyVisualCopy(slug, lang);
  return {
    slug,
    href: getLocalizedPath(getSpecialtyFamilyPath(slug), lang),
    label: copy.navLabel,
    blurb: copy.hero.subtitle || copy.navDesc,
    count: meta.specialtyCount,
    icon: specialtyFamilyIconMarkup(slug),
    image: visual.image,
    imageAlt,
    recipe: visual.recipe,
    recipeLabel: p.recipeLabels[visual.recipe],
    wide: slug === 'surgical' || slug === 'medical',
  };
});

const deepLinks = specialtiesHubDeepSlugs.map((slug) => ({
  slug,
  href: getLocalizedPath(`/${slug}`, lang),
  label: getLandingNavLabel(slug, lang),
}));

const primaryHref = getLocalizedPath('/tutorial', lang);
const secondaryHref = getLocalizedPath('/contact', lang);
const surgicalHref = getLocalizedPath(getSpecialtyFamilyPath('surgical'), lang);
const croHref = getLocalizedPath('/operative-report-ai', lang);
const countSuffix = ui.specialtiesCount;
---

<Layout title={p.title} description={p.description} jsonLd={breadcrumbLd}>
  <div class="lp-crumb-bar pt-28 sm:pt-32">
    <nav class="lp-crumb-inner" aria-label={siteUi.breadcrumb}>
      <ol class="flex flex-wrap items-center justify-center gap-2">
        <li>
          <a href={getLocalizedPath('/', lang)} class="hover:text-gray-900 transition-colors">{homeLabel}</a>
        </li>
        <li aria-hidden="true">/</li>
        <li class="text-gray-900 font-medium">{specialtiesLabel}</li>
      </ol>
    </nav>
  </div>

  <PageHero
    eyebrow={p.hero.badge}
    title={p.hero.title}
    subtitle={p.hero.subtitle}
    lead={p.hero.lead}
    compact
  >
    <a href={primaryHref} class="btn-primary">{p.cta.primary}</a>
    <a href={secondaryHref} class="btn-secondary">{p.cta.secondary}</a>
  </PageHero>

  <p class="lp-stats-line">{p.statsLine}</p>

  <section class="relative py-10 sm:py-14 overflow-hidden bg-white">
    <div class="hub-atmosphere" aria-hidden="true"></div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="fm-media-band reveal">
        <div class="fm-media-frame" data-fm-parallax>
          <img
            src={SPECIALTIES_HUB_HERO_IMAGE}
            alt={p.media.imageAlt}
            class="fm-media-img"
            width="960"
            height="640"
            loading="eager"
            decoding="async"
          />
          <div class="fm-media-scrim" aria-hidden="true"></div>
          <p class="fm-media-caption">{p.media.caption}</p>
        </div>
        <div class="fm-media-copy">
          <span class="lp-eyebrow">
            <span class="lp-dot" aria-hidden="true"></span>
            {p.media.badge}
          </span>
          <h2 class="mt-3 text-2xl sm:text-3xl font-semibold text-gray-900 leading-snug tracking-tight">
            {p.media.title}
          </h2>
          <p class="mt-4 text-base sm:text-lg text-gray-600 leading-relaxed">
            {p.media.body}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="relative py-8 sm:py-10 lp-section-soft">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <ul class="hub-stats reveal" aria-label={p.statsLine}>
        {p.stats.map((stat, i) => (
          <li class:list={['hub-stat', `reveal-delay-${i + 1}`]}>
            <span class="hub-stat-value">{stat.value}</span>
            <span class="hub-stat-label">{stat.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="relative py-14 sm:py-20 bg-white overflow-hidden">
    <div class="hub-atmosphere" aria-hidden="true"></div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="hub-featured reveal">
        <div class="hub-featured-media">
          <img
            src={SPECIALTIES_FEATURED_IMAGE}
            alt={p.media.imageAlt}
            class="hub-featured-img"
            width="960"
            height="640"
            loading="lazy"
            decoding="async"
          />
          <div class="hub-featured-scrim" aria-hidden="true"></div>
        </div>
        <div class="hub-featured-copy">
          <span class="lp-eyebrow">
            <span class="lp-dot" aria-hidden="true"></span>
            {p.featured.badge}
          </span>
          <h2 class="hub-featured-title">{p.featured.title}</h2>
          <p class="hub-featured-body">{p.featured.body}</p>
          <div class="hub-featured-actions">
            <a href={surgicalHref} class="btn-primary">{p.featured.primary}</a>
            <a href={croHref} class="btn-secondary">{p.featured.secondary}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="relative py-14 sm:py-20 lp-section-soft">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-10 sm:mb-12 reveal">
        <span class="lp-eyebrow">
          <span class="lp-dot" aria-hidden="true"></span>
          {p.familiesBadge}
        </span>
        <h2 class="mt-3 text-2xl sm:text-3xl lg:text-4xl font-semibold text-gray-900 leading-snug tracking-tight">
          {p.familiesTitle}
        </h2>
        <p class="mt-3 text-base text-gray-500 leading-relaxed">{p.familiesSubtitle}</p>
      </div>

      <div class="hub-family-grid">
        {families.map((family, i) => (
          <a
            href={family.href}
            class:list={[
              'hub-family-card reveal',
              family.wide && 'hub-family-card--wide',
              `reveal-delay-${(i % 4) + 1}`,
            ]}
          >
            <div class="hub-family-media">
              <img
                src={family.image}
                alt={family.imageAlt}
                class="hub-family-img"
                width="640"
                height="360"
                loading="lazy"
                decoding="async"
              />
              <div class="hub-family-media-scrim" aria-hidden="true"></div>
              <div class="hub-family-badges">
                <span class="hub-pill">{family.recipeLabel}</span>
                <span class="hub-pill hub-pill--ghost">
                  {family.count} {countSuffix}
                </span>
              </div>
            </div>
            <div class="hub-family-body">
              <div class="hub-family-icon-row">
                <span class="hub-card-icon" aria-hidden="true">
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    set:html={family.icon}
                  />
                </span>
                <h3 class="hub-family-title">{family.label}</h3>
              </div>
              <p class="hub-family-text">{family.blurb}</p>
              <div class="hub-family-footer">
                <span class="hub-family-count">{family.count} {countSuffix}</span>
                <span class="hub-family-cta">{p.exploreFamily} →</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="relative py-14 sm:py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-8 sm:mb-10 reveal">
        <span class="lp-eyebrow">
          <span class="lp-dot" aria-hidden="true"></span>
          {p.deepBadge}
        </span>
        <h2 class="mt-3 text-2xl sm:text-3xl lg:text-4xl font-semibold text-gray-900 leading-snug tracking-tight">
          {p.deepTitle}
        </h2>
        <p class="mt-3 text-base text-gray-500 leading-relaxed">{p.deepSubtitle}</p>
      </div>

      <ul class="hub-deep-grid reveal">
        {deepLinks.map((item, i) => (
          <li class:list={[`reveal-delay-${(i % 4) + 1}`]}>
            <a href={item.href} class="hub-deep-chip">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="relative py-14 sm:py-20 overflow-hidden lp-section-soft">
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="lp-cta-shell reveal">
        <div class="max-w-xl">
          <h2 class="text-2xl sm:text-3xl font-semibold text-gray-900 leading-snug tracking-tight">
            {p.cta.title}
          </h2>
          <p class="mt-3 text-base text-gray-600 leading-relaxed">{p.cta.body}</p>
          <div class="mt-6 flex flex-col sm:flex-row gap-3">
            <a href={primaryHref} class="btn-primary">{p.cta.primary}</a>
            <a href={secondaryHref} class="btn-secondary">{p.cta.secondary}</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const prefersReduced = () =>
    window.matchMedia('(prefers-reduced-motion: reduce)').matches

  document.querySelectorAll<HTMLElement>('[data-fm-parallax]').forEach((frame) => {
    if (prefersReduced()) return
    const img = frame.querySelector<HTMLElement>('.fm-media-img')
    if (!img) return

    const onScroll = () => {
      const rect = frame.getBoundingClientRect()
      const mid = rect.top + rect.height / 2 - window.innerHeight / 2
      const shift = Math.max(-12, Math.min(12, mid * -0.04))
      img.style.transform = `translate3d(0, ${shift}px, 0) scale(1.04)`
    }

    onScroll()
    window.addEventListener('scroll', onScroll, { passive: true })
  })
</script>
