---
import Layout from '../../layouts/Layout.astro';
import '../../styles/article-prose.css';
import { getLocalizedPath, formatDate, type Locale } from '../../utils/i18n';
import { getEntry, getCollection, render } from 'astro:content';
import { getBlogAlternateUrls, isCanonicalBlogPostId } from '../../utils/blog-translations';
import { buildBreadcrumbLd, SITE_URL, absoluteLocalizedUrl } from '../../utils/seo';
import { getLandingNavLabel } from '../../content/landings';

interface Props {
  locale: Locale;
  slug: string;
  post: any;
}

const { locale, slug, post } = Astro.props as Props;

const entry = await getEntry('pages', locale);
const t = entry!.data;
const blog = t.blog as typeof t.blog & {
  onThisPage?: string;
  writtenBy?: string;
  share?: string;
  relatedArticles?: string;
  createdOn?: string;
};

const { Content } = await render(post);

const categoryColors: Record<string, string> = {
  news: 'border-sky-100 bg-sky-50 text-sky-700',
  ai: 'border-[rgba(var(--dn-primary-rgb),0.2)] bg-[rgba(var(--dn-primary-rgb),0.08)] text-[var(--dn-primary-ink)]',
  documentation: 'border-emerald-100 bg-emerald-50 text-emerald-700',
  practice: 'border-amber-100 bg-amber-50 text-amber-800',
};

const alternates = getBlogAlternateUrls(locale, slug as string);
const postUrl = absoluteLocalizedUrl(`/blog/${slug}`, locale);
const postImage = post.data.image.startsWith('http')
  ? post.data.image
  : `${SITE_URL}${post.data.image}`;

const blogPostingLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.excerpt,
  image: postImage,
  datePublished: post.data.date,
  dateModified: post.data.date,
  inLanguage: locale,
  author: {
    '@type': 'Person',
    name: post.data.author,
    jobTitle: post.data.authorRole,
  },
  publisher: {
    '@type': 'Organization',
    name: 'DocNote',
    logo: {
      '@type': 'ImageObject',
      url: `${SITE_URL}/images/logo.png`,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': postUrl,
  },
  url: postUrl,
};

const breadcrumbLd = buildBreadcrumbLd([
  { name: 'DocNote', url: absoluteLocalizedUrl('/', locale) },
  { name: blog.title, url: absoluteLocalizedUrl('/blog/', locale) },
  { name: post.data.title, url: postUrl },
]);

const allPosts = await getCollection('blog', ({ id }) => isCanonicalBlogPostId(id));
const relatedPosts = allPosts
  .filter((p) => {
    const [loc, ...rest] = p.id.replace(/\.mdx?$/, '').split('/');
    const s = rest.join('/');
    return loc === locale && s !== slug && p.data.category === post.data.category;
  })
  .sort((a, b) => +new Date(b.data.date) - +new Date(a.data.date))
  .slice(0, 3);

const relatedFallback = allPosts
  .filter((p) => {
    const [loc, ...rest] = p.id.replace(/\.mdx?$/, '').split('/');
    const s = rest.join('/');
    return loc === locale && s !== slug;
  })
  .sort((a, b) => +new Date(b.data.date) - +new Date(a.data.date))
  .slice(0, 3);

const related = relatedPosts.length ? relatedPosts : relatedFallback;

const labels = {
  onThisPage: blog.onThisPage || 'On this page',
  writtenBy: blog.writtenBy || 'Written by',
  share: blog.share || blog.shareArticle || 'Share',
  relatedArticles: blog.relatedArticles || 'Related articles',
  createdOn: blog.createdOn || 'Published',
  backToBlog: blog.backToBlog,
  minRead: blog.minRead,
};

const homeLabel = locale === 'fr' ? 'Accueil' : locale === 'de' ? 'Start' : 'Home';
---

<Layout
  title={post.data.title}
  description={post.data.excerpt}
  alternates={alternates}
  ogType="article"
  ogImage={postImage}
  jsonLd={[blogPostingLd, breadcrumbLd]}
>
  <div class="relative min-h-screen bg-white">
    <div class="pointer-events-none absolute inset-0 overflow-hidden -z-10" aria-hidden="true">
      <div class="absolute -top-40 -right-40 w-[600px] h-[600px] rounded-full bg-[rgba(var(--dn-primary-rgb),0.08)] blur-3xl"></div>
      <div class="absolute top-1/2 -left-60 w-[500px] h-[500px] rounded-full bg-[rgba(var(--dn-primary-end-rgb,124,92,255),0.06)] blur-3xl"></div>
    </div>

    <div class="relative z-10 pt-24 lg:pt-28 pb-24 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto mb-8">
        <nav class="flex items-center gap-2 text-sm text-slate-500" aria-label="Breadcrumb">
          <a href={getLocalizedPath('/', locale)} class="hover:text-[var(--dn-primary-ink)] transition-colors">{homeLabel}</a>
          <span>/</span>
          <a href={getLocalizedPath('/blog', locale)} class="hover:text-[var(--dn-primary-ink)] transition-colors">{blog.title}</a>
          <span>/</span>
          <span class="text-slate-800 line-clamp-1">{post.data.title}</span>
        </nav>
      </div>

      <div class="max-w-7xl mx-auto">
        <div class="lg:grid lg:grid-cols-[300px_1fr] xl:grid-cols-[340px_1fr] lg:gap-12 xl:gap-16 lg:items-start">
          <aside class="hidden lg:block self-start sticky top-32">
            <div class="space-y-8">
              <div class="rounded-2xl border border-slate-100 bg-white/80 backdrop-blur-sm p-5 shadow-sm">
                <p class="text-xs font-semibold uppercase tracking-widest text-slate-400 mb-4">{labels.onThisPage}</p>
                <nav id="toc-nav" aria-label="Table of contents">
                  <ul id="toc-list" class="space-y-1 text-sm"></ul>
                </nav>
              </div>

              <div class="rounded-2xl border border-slate-100 bg-white/80 backdrop-blur-sm p-5 shadow-sm">
                <p class="text-xs font-semibold uppercase tracking-widest text-slate-400 mb-4">{labels.writtenBy}</p>
                <div class="flex items-center gap-3">
                  <img
                    src={post.data.authorImage}
                    alt={post.data.author}
                    class="w-11 h-11 rounded-full object-cover ring-2 ring-[rgba(var(--dn-primary-rgb),0.2)] flex-shrink-0"
                    width="44"
                    height="44"
                  />
                  <div>
                    <p class="font-semibold text-slate-900 text-sm">{post.data.author}</p>
                    <p class="text-xs text-slate-500 mt-0.5">{post.data.authorRole}</p>
                  </div>
                </div>

                <div class="mt-6 pt-4 border-t border-slate-200">
                  <p class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-3">{labels.share}</p>
                  <div class="flex items-center gap-2">
                    <a
                      href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(postUrl)}&text=${encodeURIComponent(post.data.title)}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="w-8 h-8 flex items-center justify-center rounded-lg bg-slate-100 hover:bg-[rgba(var(--dn-primary-rgb),0.12)] text-slate-500 hover:text-[var(--dn-primary-ink)] transition-colors"
                      aria-label="Share on X"
                    >
                      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                    </a>
                    <a
                      href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(postUrl)}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="w-8 h-8 flex items-center justify-center rounded-lg bg-slate-100 hover:bg-[rgba(var(--dn-primary-rgb),0.12)] text-slate-500 hover:text-[var(--dn-primary-ink)] transition-colors"
                      aria-label="Share on LinkedIn"
                    >
                      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                    </a>
                    <button
                      type="button"
                      data-copy-link
                      class="w-8 h-8 flex items-center justify-center rounded-lg bg-slate-100 hover:bg-[rgba(var(--dn-primary-rgb),0.12)] text-slate-500 hover:text-[var(--dn-primary-ink)] transition-colors"
                      aria-label="Copy link"
                    >
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
                    </button>
                  </div>
                </div>
              </div>

              <div class="rounded-2xl border border-slate-100 bg-white/80 backdrop-blur-sm p-5 shadow-sm">
                <p class="text-xs font-semibold uppercase tracking-widest text-slate-400 mb-3">DocNote</p>
                <ul class="space-y-2 text-sm">
                  <li><a class="text-[var(--dn-primary-ink)] hover:underline" href={getLocalizedPath('/ai-medical-scribe', locale)}>{getLandingNavLabel('ai-medical-scribe', locale)}</a></li>
                  <li><a class="text-[var(--dn-primary-ink)] hover:underline" href={getLocalizedPath('/pricing', locale)}>{t.nav.pricing}</a></li>
                  <li><a class="text-[var(--dn-primary-ink)] hover:underline" href={getLocalizedPath('/tutorial', locale)}>{t.nav.tutorial}</a></li>
                </ul>
              </div>
            </div>
          </aside>

          <main class="w-full min-w-0 max-w-[700px] mx-auto lg:mx-0">
            <header class="mb-10">
              <div class="flex flex-wrap items-center gap-3 mb-5">
                {categoryColors[post.data.category] && (
                  <span class={`inline-flex items-center rounded-full border px-3 py-1 text-xs font-medium ${categoryColors[post.data.category]}`}>
                    {t.blog.categories[post.data.category as keyof typeof t.blog.categories]}
                  </span>
                )}
                <time class="inline-flex items-center gap-1.5 text-sm text-slate-400" datetime={post.data.date}>
                  <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                  <span>{labels.createdOn} {formatDate(post.data.date, locale)}</span>
                </time>
                {post.data.readTime ? (
                  <>
                    <span class="text-sm text-slate-400">&middot;</span>
                    <span class="text-sm text-slate-400">{post.data.readTime} {labels.minRead}</span>
                  </>
                ) : null}
              </div>

              <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 leading-tight mb-6 tracking-tight">
                {post.data.title}
              </h1>

              <p class="text-xl text-slate-600 leading-relaxed">
                {post.data.excerpt}
              </p>

              <div class="flex items-center gap-3 mt-8 pt-8 border-t border-slate-100 lg:hidden">
                <img
                  src={post.data.authorImage}
                  alt={post.data.author}
                  class="w-10 h-10 rounded-full object-cover ring-2 ring-[rgba(var(--dn-primary-rgb),0.2)] flex-shrink-0"
                  width="40"
                  height="40"
                />
                <div>
                  <p class="text-xs font-medium text-slate-400 mb-0.5">{labels.writtenBy}</p>
                  <p class="font-medium text-slate-900 text-sm">{post.data.author}</p>
                  <p class="text-xs text-slate-500">{post.data.authorRole}</p>
                </div>
              </div>
            </header>

            <div class="rounded-2xl overflow-hidden mb-12 shadow-sm border border-slate-100">
              <img
                src={post.data.image}
                alt={post.data.title}
                class="w-full object-cover aspect-[16/9]"
                width="1200"
                height="675"
                loading="eager"
                decoding="async"
              />
            </div>

            <div class="lg:hidden mb-10 rounded-2xl border border-slate-100 bg-slate-50 p-5">
              <p class="text-xs font-semibold uppercase tracking-widest text-slate-400 mb-3">{labels.onThisPage}</p>
              <nav aria-label="Table of contents (mobile)">
                <ul id="toc-list-mobile" class="space-y-1 text-sm"></ul>
              </nav>
            </div>

            <div id="article-content" class="article-prose">
              <Content />
            </div>

            <div class="mt-10">
              <a
                href={getLocalizedPath('/blog', locale)}
                class="inline-flex items-center gap-2 text-sm font-medium text-[var(--dn-primary-ink)] hover:opacity-80 transition-opacity group"
              >
                <svg class="w-4 h-4 transition-transform group-hover:-translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
                {labels.backToBlog}
              </a>
            </div>
          </main>
        </div>
      </div>

      {related.length > 0 && (
        <section class="mt-16 pt-12 border-t border-slate-200 max-w-7xl mx-auto">
          <h2 class="text-2xl font-bold text-gray-900 mb-8">{labels.relatedArticles}</h2>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
            {related.map((relPost) => {
              const relSlug = relPost.id.replace(/\.mdx?$/, '').split('/').slice(1).join('/');
              return (
                <a href={getLocalizedPath(`/blog/${relSlug}`, locale)} class="group block">
                  <div class="aspect-[16/9] rounded-xl overflow-hidden mb-4 bg-slate-100 border border-slate-100">
                    <img
                      src={relPost.data.image}
                      alt={relPost.data.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      width="800"
                      height="450"
                      loading="lazy"
                    />
                  </div>
                  <h3 class="font-semibold text-gray-900 group-hover:text-[var(--dn-primary-ink)] transition-colors line-clamp-2">{relPost.data.title}</h3>
                  <p class="mt-1 text-sm text-slate-500">{formatDate(relPost.data.date, locale)}</p>
                </a>
              );
            })}
          </div>
        </section>
      )}
    </div>
  </div>
</Layout>

<script>
  const copyBtn = document.querySelector<HTMLButtonElement>('[data-copy-link]');
  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
      copyBtn.style.color = '#22c55e';
      window.setTimeout(() => {
        copyBtn.style.color = '';
      }, 1500);
    } catch {
      /* ignore */
    }
  });

  function buildTOC() {
    const content = document.getElementById('article-content');
    if (!content) return;

    const headings = Array.from(content.querySelectorAll('h2'));
    const tocList = document.getElementById('toc-list');
    const tocListMobile = document.getElementById('toc-list-mobile');

    if (headings.length === 0) {
      const sidebarToc = tocList?.closest('.rounded-2xl');
      if (sidebarToc) (sidebarToc as HTMLElement).style.display = 'none';
      const mobileToc = tocListMobile?.closest('.rounded-2xl');
      if (mobileToc) (mobileToc as HTMLElement).style.display = 'none';
      return;
    }

    const createLink = (id: string, label: string) => {
      const a = document.createElement('a');
      a.href = `#${id}`;
      a.textContent = label;
      a.title = label;
      a.addEventListener('click', (e) => {
        e.preventDefault();
        document.getElementById(id)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
      return a;
    };

    headings.forEach((heading, index) => {
      if (!heading.id) {
        const text = heading.textContent || '';
        heading.id =
          text
            .toLowerCase()
            .replace(/[^a-z0-9\s-]/g, '')
            .replace(/\s+/g, '-')
            .replace(/-+/g, '-')
            .replace(/^-|-$/g, '') || `heading-${index}`;
      }
      const text = heading.textContent || '';
      if (tocList) {
        const li = document.createElement('li');
        li.appendChild(createLink(heading.id, text));
        tocList.appendChild(li);
      }
      if (tocListMobile) {
        const li = document.createElement('li');
        li.appendChild(createLink(heading.id, text));
        tocListMobile.appendChild(li);
      }
    });

    const allTocLinks = () => [
      ...Array.from(document.querySelectorAll('#toc-list a')),
      ...Array.from(document.querySelectorAll('#toc-list-mobile a')),
    ];

    const setActive = (id: string) => {
      allTocLinks().forEach((link) => {
        const a = link as HTMLAnchorElement;
        a.classList.toggle('toc-active', a.getAttribute('href') === `#${id}`);
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        let topMost: { id: string; top: number } | null = null;
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const top = entry.boundingClientRect.top;
          if (!topMost || top < topMost.top) topMost = { id: entry.target.id, top };
        });
        if (topMost) setActive(topMost.id);
      },
      { rootMargin: '-100px 0px -60% 0px', threshold: 0 }
    );

    headings.forEach((h) => observer.observe(h));
    if (headings[0]?.id) setActive(headings[0].id);
  }

  buildTOC();
  document.addEventListener('astro:page-load', buildTOC);
</script>
