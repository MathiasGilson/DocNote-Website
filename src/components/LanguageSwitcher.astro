---
import {
  locales,
  localeNames,
  flagSrcs,
  getLocalizedPath,
  getPathWithoutLocale,
  getSurveyAlternatePaths,
  isSurveyPath,
  getCareersAlternatePaths,
  isCareersPath,
  type Locale,
} from '../utils/i18n';
import { getBlogAlternatePaths } from '../utils/blog-translations';
import { getBlogAllAlternatePaths } from '../utils/seo';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const pathname = Astro.url.pathname;
const basePath = getPathWithoutLocale(pathname);
const blogAllMatch = basePath.match(/^\/blog\/all\/(\d+)\/?$/);
const blogSlug = !blogAllMatch ? basePath.match(/^\/blog\/([^/]+)\/$/)?.[1] : undefined;
const careersJobSlug = basePath.match(/^\/(?:careers|emploi)\/([^/]+)\/$/)?.[1];
const hrefByLocale = blogAllMatch
  ? await getBlogAllAlternatePaths(Number(blogAllMatch[1]))
  : blogSlug
    ? getBlogAlternatePaths(locale, blogSlug)
    : isSurveyPath(pathname)
      ? getSurveyAlternatePaths()
      : isCareersPath(pathname)
        ? getCareersAlternatePaths(careersJobSlug)
        : null;
---

<div class="relative lang-switcher">
  <button
    type="button"
    class="lang-switcher-btn inline-flex items-center justify-center gap-2 px-5 py-2.5 text-base font-medium text-gray-700 bg-gray-100 rounded-full hover:bg-gray-200 transition-all whitespace-nowrap"
    aria-label="Select language"
    aria-haspopup="listbox"
    aria-expanded="false"
  >
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
    </svg>
    <span class="uppercase">{locale}</span>
    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <div class="lang-dropdown hidden absolute right-0 mt-2 w-44 max-h-72 overflow-y-auto overscroll-contain bg-white rounded-lg shadow-lg border border-gray-100 py-1 z-50" role="listbox" aria-label="Languages">
    {locales.map((code) => (
      <a
        href={hrefByLocale ? hrefByLocale[code] : getLocalizedPath(basePath, code)}
        hreflang={code}
        lang={code}
        role="option"
        aria-selected={code === locale ? 'true' : 'false'}
        class:list={[
          'flex items-center gap-2.5 px-4 py-2 text-sm hover:bg-gray-50 transition-colors',
          code === locale ? 'text-primary-600 font-medium' : 'text-gray-700'
        ]}
      >
        <img
          src={flagSrcs[code]}
          alt=""
          width={20}
          height={14}
          loading="lazy"
          decoding="async"
          class="w-5 h-3.5 object-cover rounded-[2px] flex-shrink-0"
          aria-hidden="true"
        />
        <span>{localeNames[code]}</span>
      </a>
    ))}
  </div>
</div>

<script>
  const switchers = document.querySelectorAll<HTMLElement>('.lang-switcher');

  switchers.forEach((switcher) => {
    const dropdown = switcher.querySelector<HTMLElement>('.lang-dropdown');
    const button = switcher.querySelector<HTMLButtonElement>('.lang-switcher-btn');

    button?.addEventListener('click', () => {
      const open = dropdown?.classList.toggle('hidden') === false;
      button.setAttribute('aria-expanded', open ? 'true' : 'false');
    });

    document.addEventListener('click', (e) => {
      if (!switcher.contains(e.target as Node)) {
        dropdown?.classList.add('hidden');
        button?.setAttribute('aria-expanded', 'false');
      }
    });
  });
</script>
