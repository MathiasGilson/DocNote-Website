---
import { getLocaleFromUrl, getLocalizedPath } from "../utils/i18n"
import FaqAccordion from "./FaqAccordion.astro"

interface Props {
    translations: any
}

const { translations: t } = Astro.props
const locale = getLocaleFromUrl(Astro.url)

// Items 2, 3 and 8 have location-aware variants (CH = Swiss DRG/FADP/CHF,
// ROW = PMSI/GDPR/EUR). The page is rendered server-side with the ROW
// variant by default; a small client script swaps to the CH variant when
// the visitor is detected as Swiss (timezone first, then IP fallback).
const items = [
    { q: t.faq.q1, a: t.faq.a1 },
    { q: t.faq.q2, a: t.faq.a2Row, aCh: t.faq.a2Ch, aRow: t.faq.a2Row, locationAware: true },
    { q: t.faq.q3, a: t.faq.a3Row, aCh: t.faq.a3Ch, aRow: t.faq.a3Row, locationAware: true },
    { q: t.faq.q4, a: t.faq.a4 },
    { q: t.faq.q5, a: t.faq.a5 },
    { q: t.faq.q6, a: t.faq.a6 },
    { q: t.faq.q7, a: t.faq.a7 },
    { q: t.faq.q8, a: t.faq.a8Row, aCh: t.faq.a8Ch, aRow: t.faq.a8Row, locationAware: true },
    { q: t.faq.q9, a: t.faq.a9 },
]

// Prefer CH answers for DE (Swiss-German market); ROW for EN/FR default SERP copy.
const schemaPreferCh = locale === "de"
const faqJsonLd = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    inLanguage: locale,
    mainEntity: items.map((item) => ({
        "@type": "Question",
        name: item.q,
        acceptedAnswer: {
            "@type": "Answer",
            text: item.locationAware
                ? schemaPreferCh
                    ? item.aCh || item.a
                    : item.aRow || item.a
                : item.a,
        },
    })),
}
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

<section id="faq" class="py-16 sm:py-20 scroll-mt-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8 reveal">
            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-semibold text-gray-900 mb-2">
                {t.faq.title}
            </h2>
            <p class="text-gray-500">
                {t.faq.subtitle}
                <a href={getLocalizedPath("/contact", locale)} class="underline hover:text-gray-900 transition-colors">{t.faq.contactUs}</a>
            </p>
        </div>

        <div class="reveal reveal-delay-1">
            <FaqAccordion items={items} />
        </div>
    </div>
</section>

<script>
    import { detectUserCurrency } from "../utils/currency"

    ;(async () => {
        const els = document.querySelectorAll<HTMLElement>("[data-faq-location-aware]")
        if (!els.length) return
        const currency = await detectUserCurrency()
        const useCh = currency === "CHF"
        els.forEach((el) => {
            const ch = el.dataset.answerCh || ""
            const row = el.dataset.answerRow || ""
            el.textContent = useCh ? ch : row
        })
    })()
</script>
