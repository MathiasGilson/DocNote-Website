---
import { getEntry } from 'astro:content';
import { type Locale } from '../utils/i18n';
import { getSiteUi } from '../utils/inline-content';

interface Props {
  locale?: Locale | string;
}

const { locale = 'en' } = Astro.props;

const entry = await getEntry('pages', locale);
const enEntry = locale === 'en' ? entry : await getEntry('pages', 'en');
const t = entry?.data ?? enEntry!.data;
const enTeam = enEntry!.data.team;
const locTeam = t.team;

const membersData = Object.fromEntries(
  Object.keys(enTeam.members).map((key) => {
    const enMember = enTeam.members[key as keyof typeof enTeam.members];
    const locMember = locTeam.members?.[key as keyof typeof locTeam.members];
    return [
      key,
      {
        name: locMember?.name || enMember.name,
        role: locMember?.role || enMember.role,
      },
    ];
  })
) as Record<string, { name: string; role: string }>;

// Same assets as live docnote.ch/en/team/ (original portraits, not AI studio regenerations).
const members = [
  { key: 'vincentTan', image: '/images/dr_vincent_tan.jpg' },
  { key: 'aliceGilson', image: '/images/dre_alice_gilson.jpg' },
  { key: 'mathiasGilson', image: '/images/mathias_gilson.png' },
  { key: 'jeremyYvinec', image: '/images/jeremy_yvinec.jpg' },
  { key: 'hugoRoussel', image: '/images/hugo_roussel.jpg' },
  { key: 'ericWei', image: '/images/eric_wei.jpg' },
  { key: 'nedimAmer', image: '/images/nedim_amer.jpg' },
  { key: 'valeryDemunck', image: '/images/valery_demunck.jpg' },
  { key: 'julietteKristanek', image: '/images/juliette_kristanek.jpg' },
] as const;

const marqueeItems = [...members, ...members];

const regionLabel = getSiteUi(locale).teamMembers;
---

<div
  class="team-marquee reveal"
  data-team-marquee
  role="region"
  aria-label={regionLabel}
  tabindex="0"
>
  <div class="team-marquee__track" data-team-marquee-track>
    {
      marqueeItems.map((m, i) => {
        const person = membersData[m.key];
        const isClone = i >= members.length;
        return (
          <article class="team-card" aria-hidden={isClone ? 'true' : undefined}>
            <div class="team-card__media">
              <img
                src={m.image}
                alt={person.name}
                width="480"
                height="640"
                sizes="250px"
                loading={i < 4 ? 'eager' : 'lazy'}
                decoding="async"
                class="team-card__photo"
                data-member={m.key}
                draggable="false"
              />
            </div>
            <p class="team-card__name">{person.name}</p>
            <p class="team-card__role">{person.role}</p>
          </article>
        );
      })
    }
  </div>
</div>

<style>
  .team-marquee {
    overflow-x: auto;
    overflow-y: hidden;
    outline: none;
    cursor: grab;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 3%, #000 97%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 3%, #000 97%, transparent);
  }

  .team-marquee::-webkit-scrollbar {
    display: none;
  }

  .team-marquee.is-dragging {
    cursor: grabbing;
  }

  .team-marquee:focus-visible {
    outline: 2px solid var(--dn-primary-mid);
    outline-offset: 4px;
  }

  .team-marquee__track {
    display: flex;
    gap: 1.5rem;
    width: max-content;
    padding-inline: 1rem;
    will-change: transform;
  }

  .team-card {
    width: 250px;
    flex-shrink: 0;
    user-select: none;
  }

  .team-card__media {
    aspect-ratio: 3 / 4;
    width: 100%;
    overflow: hidden;
    border-radius: 20px;
    background: linear-gradient(145deg, #e8eefc, #ebe7f8);
    box-shadow: var(--dn-glow-sm);
  }

  .team-card__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    transition: transform 0.5s ease;
    pointer-events: none;
  }

  .team-card:hover .team-card__photo {
    transform: scale(1.06);
  }

  .team-card__name {
    margin-top: 1rem;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
    color: #111827;
  }

  .team-card__role {
    margin-top: 0.125rem;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--dn-primary-ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .team-marquee {
      overflow: visible;
      cursor: default;
      -webkit-mask-image: none;
      mask-image: none;
      max-width: 72rem;
      margin-inline: auto;
      padding-inline: 1rem;
    }

    .team-marquee__track {
      flex-wrap: wrap;
      justify-content: center;
      width: auto;
      max-width: 100%;
      will-change: auto;
      gap: 1.5rem 1.25rem;
    }

    .team-card[aria-hidden='true'] {
      display: none;
    }

    .team-card__photo {
      transition: none;
    }

    .team-card:hover .team-card__photo {
      transform: none;
    }
  }
</style>

<script>
  const prefersReduced = () =>
    window.matchMedia('(prefers-reduced-motion: reduce)').matches

  const initMarquees = () => {
    document.querySelectorAll('[data-team-marquee]').forEach((node) => {
      if (!(node instanceof HTMLElement) || node.dataset.ready === '1') return
      node.dataset.ready = '1'

      if (prefersReduced()) return

      const track = node.querySelector('[data-team-marquee-track]')
      if (!(track instanceof HTMLElement)) return

      let hovering = false
      let dragging = false
      let autoId = 0
      let dragStartX = 0
      let dragScrollLeft = 0
      const speed = 0.6

      const halfWidth = () => track.scrollWidth / 2

      const normalize = () => {
        const half = halfWidth()
        if (half <= 0) return
        if (node.scrollLeft >= half) node.scrollLeft -= half
        if (node.scrollLeft < 0) node.scrollLeft += half
      }

      const tick = () => {
        if (!hovering && !dragging) {
          node.scrollLeft += speed
          normalize()
        }
        autoId = window.requestAnimationFrame(tick)
      }

      const onWheel = (e: WheelEvent) => {
        if (Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return
        if (e.deltaX === 0) return
        e.preventDefault()
        node.scrollLeft += e.deltaX
        normalize()
      }

      node.addEventListener('wheel', onWheel, { passive: false })

      node.addEventListener('mouseenter', () => {
        hovering = true
      })
      node.addEventListener('mouseleave', () => {
        hovering = false
        dragging = false
        node.classList.remove('is-dragging')
      })

      node.addEventListener('pointerdown', (e) => {
        if (e.pointerType === 'mouse' && e.button !== 0) return
        dragging = true
        dragStartX = e.clientX
        dragScrollLeft = node.scrollLeft
        node.classList.add('is-dragging')
        node.setPointerCapture(e.pointerId)
      })

      node.addEventListener('pointermove', (e) => {
        if (!dragging) return
        const dx = e.clientX - dragStartX
        node.scrollLeft = dragScrollLeft - dx
        normalize()
      })

      const endDrag = (e: PointerEvent) => {
        if (!dragging) return
        dragging = false
        node.classList.remove('is-dragging')
        try {
          node.releasePointerCapture(e.pointerId)
        } catch {
          /* ignore */
        }
      }

      node.addEventListener('pointerup', endDrag)
      node.addEventListener('pointercancel', endDrag)

      node.addEventListener('keydown', (e) => {
        const step = 240
        if (e.key === 'ArrowRight') {
          e.preventDefault()
          node.scrollLeft += step
          normalize()
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault()
          node.scrollLeft -= step
          normalize()
        }
      })

      requestAnimationFrame(() => {
        node.scrollLeft = 1
        normalize()
        autoId = window.requestAnimationFrame(tick)
      })

      const stop = () => {
        if (autoId) cancelAnimationFrame(autoId)
      }
      window.addEventListener('pagehide', stop, { once: true })
    })
  }

  initMarquees()
  document.addEventListener('astro:page-load', initMarquees)
</script>
