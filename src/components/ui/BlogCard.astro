---
import { formatDate, type Locale } from '../../utils/i18n';

interface Props {
  href: string;
  title: string;
  excerpt: string;
  image: string;
  imagePosition?: string;
  date: string;
  locale: Locale;
  categoryLabel: string;
  categoryClass: string;
  readMore: string;
  class?: string;
}

const {
  href,
  title,
  excerpt,
  image,
  imagePosition = 'center',
  date,
  locale,
  categoryLabel,
  categoryClass,
  readMore,
  class: extra = '',
} = Astro.props;
---

<article
  class:list={[
    'group relative flex flex-col rounded-2xl bg-white border border-slate-200/70 overflow-hidden transition-all duration-300 hover:shadow-lg hover:shadow-indigo-500/5 hover:border-slate-300 reveal',
    extra,
  ]}
>
  <a href={href} class="block relative overflow-hidden" tabindex="-1" aria-hidden="true">
    <div class="relative overflow-hidden aspect-[16/9]">
      <img
        src={image}
        alt={title}
        width="800"
        height="450"
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        style={`object-position: ${imagePosition};`}
      />
    </div>
  </a>

  <div class="flex flex-col flex-1 p-5">
    <div class="flex items-center justify-between gap-2 mb-3">
      <span class:list={['inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-medium', categoryClass]}>
        {categoryLabel}
      </span>
      <time class="inline-flex items-center gap-1 text-xs text-slate-400" datetime={date}>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="4" width="18" height="18" rx="2" />
          <path d="M16 2v4M8 2v4M3 10h18" />
        </svg>
        {formatDate(date, locale)}
      </time>
    </div>

    <a href={href} class="block group/title">
      <h3 class="text-base font-semibold text-slate-900 mb-2 leading-snug group-hover/title:text-[var(--dn-primary-ink)] transition-colors duration-200 line-clamp-2">
        {title}
      </h3>
    </a>

    <p class="text-sm text-slate-500 line-clamp-2 leading-relaxed flex-1">{excerpt}</p>

    <a
      href={href}
      class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-[var(--dn-primary-ink)] hover:text-[var(--dn-primary-end)] transition-colors duration-200"
    >
      {readMore}
      <span class="sr-only">: {title}</span>
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M2.625 7H11.375M11.375 7L7.875 3.5M11.375 7L7.875 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>
</article>
